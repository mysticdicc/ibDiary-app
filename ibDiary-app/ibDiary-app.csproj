<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>ibDiary_app</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnableDefaultCssItems>false</EnableDefaultCssItems>
		<Nullable>enable</Nullable>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>ibDiary-app</ApplicationTitle>
		<ApplicationId>com.richweb.ibdiary</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">34.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<PropertyGroup>
		<TargetSdkVersion>35</TargetSdkVersion>
		<MinSdkVersion>21</MinSdkVersion>
	</PropertyGroup>
	
    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\ibdiaryiconbackground.svg" ForegroundScale="1" ForegroundFile="Resources\AppIcon\ibdiaryicon.svg" Color="#7202bd" />
        <MauiSplashScreen Include="Resources\Splash\ibdiaryiconsmall.svg" Color="#7202bd" BaseSize="256,256" />
        <MauiImage Include="Resources\Images\*" />
        <MauiFont Include="Resources\Fonts\*" />
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

	<ItemGroup>
		<MauiAsset Include="wwwroot\**" LogicalName="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <Content Remove="wwwroot\js\ibdiary.js" />
	</ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.100" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
        <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.9.1.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ibDiary-data\ibDiary-data.csproj" />
    </ItemGroup>

</Project>
