@inject ScheduledNotificationClientService _notificationService
@inject ComponentUpdateService _updateService

<Popup Visible="@Visible" VisibleChanged="@VisibleChanged" Title="Notification">
    <div class="scheduled-notification-viewer">
        <div>
            <IbdSelect Options="@_typeOptions" Title="Notification Type" @bind-Value="@_selectedType" @bind-Value:after="@OnTypeChanged"/>
        </div>
        <div>
            <IbdDateTimeInput @bind-Value="@_notification.StartAtLocal" Title="Start At" />
        </div>
        <div>
            <header>
                <h2>
                    Schedule
                </h2>
            </header>
            <div>
                <IbdSelect Options="@_intervalTypes" Title="Interval Type" @bind-Value="@_selectedInterval" @bind-Value:after="@OnIntervalTypeChanged"/>
                <IbdIntInput Title="@_intervalTitle" @bind-Value="@_notification.IntervalValue" />
            </div>
        </div>
        <div>
            <button @onclick="@OnClickCancel">
                Cancel
            </button>
            <button @onclick="@OnClickSave">
                Save
            </button>
        </div>
    </div>
</Popup>

@code {
    [Parameter] required public ScheduledNotificationDto Notification { get; set; }
    private ScheduledNotificationDto _notification = new();

    [Parameter] public EventCallback<ScheduledNotificationDto> NotificationChanged { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    private string _intervalTitle = string.Empty;

    private IbdSelectOption? _selectedType;
    private List<IbdSelectOption> _typeOptions = [
        new("Food Report Reminder", ScheduledNotificationType.Food),
        new("Symptom Report Reminder", ScheduledNotificationType.Symptom)
    ];

    private IbdSelectOption? _selectedInterval;
    private List<IbdSelectOption> _intervalTypes = [
        new("Minutes", ScheduleIntervalType.Minutes),
        new("Hours", ScheduleIntervalType.Hours),
        new("Days", ScheduleIntervalType.Days),
        new("Months", ScheduleIntervalType.Months)
    ];

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Notification, _notification)) _notification = Notification;

        _selectedType = _typeOptions.FirstOrDefault(x => x.Value?.Equals(_notification.Type) ?? false);
        _selectedInterval = _intervalTypes.FirstOrDefault(x => x.Value?.Equals(_notification.IntervalType) ?? false);
        UpdateIntervalTitle();
        base.OnParametersSet();
    }

    private async Task OnVisibleChamged(bool visible)
    {
        await VisibleChanged.InvokeAsync(visible);
    }

    private async Task OnClickSave()
    {
        bool success = false;

        if (_notification.IsNew)
        {
            success = await _notificationService.AddAsync(_notification) > 0;
        }
        else
        {
            success = await _notificationService.UpdateAsync(_notification);
        }

        if (success)
        {
            _updateService.NotifiyComponentUpdate(_notification);
            await NotificationChanged.InvokeAsync(_notification);
            await OnClickCancel();
        }
    }

    private async Task OnClickCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }

    private void UpdateIntervalTitle()
    {
        _intervalTitle = _notification.IntervalType switch
        {
            ScheduleIntervalType.Minutes => "Minutes",
            ScheduleIntervalType.Hours => "Hours",
            ScheduleIntervalType.Days => "Days",
            ScheduleIntervalType.Months => "Months",
            _ => string.Empty
        };
    }

    private async Task OnTypeChanged()
    {
        if (_selectedType is null) return;
        if (_selectedType.Value is not ScheduledNotificationType type || _selectedType.Value == null) return;
        _notification.Type = type;
        await NotificationChanged.InvokeAsync(_notification);
    }

    private async Task OnIntervalTypeChanged()
    {
        if (_selectedInterval is null) return;
        if (_selectedInterval.Value is not ScheduleIntervalType type || _selectedInterval.Value == null) return;
        _notification.IntervalType = type;
        UpdateIntervalTitle();
        await NotificationChanged.InvokeAsync(_notification);
    }
}
