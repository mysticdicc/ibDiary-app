@inject FoodItemClientService _foodService
@inject ComponentUpdateService _updateService

<Popup Visible="@Visible" VisibleChanged="@OnVisibleChamged" Title="@_title">
    <EditForm Model="@_food" OnValidSubmit="@OnClickSave">
        <DataAnnotationsValidator />

        <div class="food-item-viewer">
            <div>
                <IbdTextInput @bind-Value="@_food.Name" Title="Name" />
            </div>
            <div>
                <IbdTextArea @bind-Value="@_food.Description" Title="Description" />
            </div>
            <div>
                <button type="button" @onclick="@OnClickCancel">
                    Cancel
                </button>
                <button type="submit">
                    Save
                </button>
            </div>
        </div>
    </EditForm>
</Popup>

@code {
    [Parameter] required public FoodItemDto Food { get; set; }
    private FoodItemDto _food = new();

    [Parameter] public EventCallback<FoodItemDto> FoodChanged { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    private string _title = string.Empty;

    protected override Task OnParametersSetAsync()
    {
        if (!ReferenceEquals(Food, _food)) _food = Food;

        if (_food.IsNew) _title = "Add Food";
        else _title = _food.Name;
        return base.OnParametersSetAsync();
    }

    private async Task OnVisibleChamged(bool visible)
    {
        await VisibleChanged.InvokeAsync(visible);
    }

    private async Task OnClickCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }

    private async Task OnClickSave()
    {
        bool result = false;

        if (Food.IsNew)
        {
            result = await _foodService.AddAsync(_food) > 0;
        }
        else
        {
            result = await _foodService.UpdateAsync(_food);
        }

        if (result)
        {
            _updateService.NotifiyComponentUpdate(_food);
            await FoodChanged.InvokeAsync(_food);
            await OnClickCancel();
        }
    }
}
