<div class="food-item-card small-card" @onclick="@OnClickCard">
    <header>
        <h3>@Food.Name</h3>
        <button @onclick="@OnDeleteClicked" @onclick:stopPropagation="true">
            <span class="material-symbols-outlined">delete</span>
        </button>
    </header>
    <div>
        <p>@Food.Description</p>
    </div>
    <div>
        <p>Added on: @Food.CreatedAtLocalDate</p>
        <button @onclick="@OnClickCreateReport" @onclick:stopPropagation="true">
            Create Report
            <span class="material-symbols-outlined">article</span>
        </button>
    </div>
</div>

<FoodItemReportViewer Report="@_report" @bind-Visible="@_reportVisible"/>

@code {
    [Parameter] public FoodItemDto Food { get; set; } = new();
    [Parameter] public EventCallback<FoodItemDto> FoodClicked { get; set; }
    [Parameter] public EventCallback<FoodItemDto> DeleteClicked { get; set; }
    private FoodItemReportDto _report = new();
    private bool _reportVisible = false;

    protected override Task OnParametersSetAsync()
    {
        _report = new(Food);
        return base.OnParametersSetAsync();
    }

    private async Task OnClickCard()
    {
        await FoodClicked.InvokeAsync(Food);
    }

    private async Task OnClickCreateReport()
    {
        _reportVisible = true;
    }

    private async Task OnDeleteClicked()
    {
        await DeleteClicked.InvokeAsync(Food);
    }
}
