@inject MealReportClientService _mealReportService
@inject ComponentUpdateService _updateService

<Popup Visible="@Visible" VisibleChanged="@VisibleChanged" Title="Meal Report">
    <EditForm Model="@_report" OnValidSubmit="@OnClickSave">
        <DataAnnotationsValidator />

        <div class="meal-item-report-viewer">
            <div>
                <MealSearcher @bind-Value="@_report.Meal" ShowSelected="true" />
            </div>
            <div>
                <IbdDateTimeInput @bind-Value="@_report.AteMealAt" Title="Ate At" />
            </div>
            <div>
                <IbdTextArea @bind-Value="@_report.Notes" Title="Notes" />
            </div>
            <div>
                <button type="button" @onclick="@OnClickCancel">
                    Cancel
                </button>
                <button type="submit">
                    Save
                </button>
            </div>
        </div>
    </EditForm>
</Popup>


@code {
    [Parameter] public MealReport Report { get; set; } = new();
    [Parameter] public EventCallback<MealReport> ReportChanged { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    private MealReport _report = new();

    protected override void OnParametersSet()
    {
        if (Report != _report) _report = Report.Clone();
        base.OnParametersSet();
    }

    private async Task OnVisibleChamged(bool visible)
    {
        await VisibleChanged.InvokeAsync(visible);
    }

    private async Task OnClickCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }

    private async Task OnClickSave()
    {
        bool result = false;

        if (_report.IsNew)
        {
            result = await _mealReportService.AddAsync(_report) > 0;
        }
        else
        {
            result = await _mealReportService.UpdateAsync(_report);
        }

        if (result)
        {
            _updateService.NotifiyComponentUpdate(_report);
            await ReportChanged.InvokeAsync(_report);
            await OnClickCancel();
        }
    }
}
