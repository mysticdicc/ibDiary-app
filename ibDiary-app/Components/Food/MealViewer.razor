@inject MealClientService _mealService
@inject ComponentUpdateService _updateService

<Popup Visible="@Visible" VisibleChanged="@OnVisibleChamged" Title="@_title">
    <EditForm Model="@_meal" OnValidSubmit="@OnClickSave">
        <DataAnnotationsValidator />

        <div class="meal-viewer">
            <div>
                <IbdTextInput @bind-Value="@_meal.Name" Title="Name" />
            </div>
            <div>
                <IbdTextArea @bind-Value="@_meal.Notes" Title="Notes" />
            </div>
            <div>
                <header>
                    <h3>Food Items</h3>
                    <FoodSearcher @bind-Value="@_selectedFood" @bind-Value:after="@OnFoodItemChanged"/>
                </header>
                @foreach (var food in _meal.FoodItems)
                {
                    <FoodItemSmallCard Food="food" DeleteClicked="@OnFoodItemDeleted" />
                }
            </div>
            <div>
                <button type="button" @onclick="@OnClickCancel">
                    Cancel
                </button>
                <button type="submit">
                    Save
                </button>
            </div>
        </div>
    </EditForm>
</Popup>

@code {
    [Parameter] public Meal Meal { get; set; } = new();
    [Parameter] public EventCallback<Meal> MealChanged { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    private Meal _meal = new();
    private FoodItem _selectedFood = new();
    private string _title = string.Empty;

    protected override Task OnParametersSetAsync()
    {
        if (Meal != _meal) _meal = Meal.Clone();
        _title = _meal.IsNew ? "Add Meal" : _meal.Name;
        return base.OnParametersSetAsync();
    }

    private async Task OnVisibleChamged(bool visible)
    {
        await VisibleChanged.InvokeAsync(visible);
    }

    private async Task OnClickCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }

    private async Task OnClickSave()
    {
        bool result = false;

        if (_meal.IsNew)
        {
            result = await _mealService.AddAsync(_meal) > 0;
        }
        else
        {
            result = await _mealService.UpdateAsync(_meal);
        }

        if (result)
        {
            _updateService.NotifiyComponentUpdate(_meal);
            await MealChanged.InvokeAsync(_meal);
            await OnClickCancel();
        }
    }

    private void OnFoodItemChanged()
    {
        if (!_meal.FoodItems.Contains(_selectedFood)) _meal.FoodItems.Add(_selectedFood);
    }

    private void OnFoodItemDeleted(FoodItem foodItem)
    {
        if (_meal.FoodItems.Contains(foodItem)) _meal.FoodItems.Remove(foodItem);
    }
}
