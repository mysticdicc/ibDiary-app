@inject MealClientService _mealService
@inject ComponentUpdateService _updateService

<Popup Visible="@Visible" VisibleChanged="@OnVisibleChamged" Title="@_title">
    <EditForm Model="@Meal" OnValidSubmit="@OnClickSave">
        <DataAnnotationsValidator />

        <div class="meal-viewer">
            <div>
                <IbdTextInput @bind-Value="@Meal.Name" Title="Name" />
            </div>
            <div>
                <IbdTextArea @bind-Value="@Meal.Notes" Title="Notes" />
            </div>
            <div>
                <header>
                    <h3>Food Items</h3>
                    <FoodSearcher @bind-Value="@_selectedFood" @bind-Value:after="@OnFoodItemChanged"/>
                </header>
                @foreach (var food in Meal.FoodItems)
                {
                    <FoodItemSmallCard Food="food" DeleteClicked="@OnFoodItemDeleted" />
                }
            </div>
            <div>
                <button @onclick="@OnClickCancel">
                    Cancel
                </button>
                <button type="submit">
                    Save
                </button>
            </div>
        </div>
    </EditForm>
</Popup>

@code {
    [Parameter] public Meal Meal { get; set; } = new();
    [Parameter] public EventCallback<Meal> MealChanged { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    private FoodItem _selectedFood = new();
    string _title = string.Empty;

    protected override Task OnParametersSetAsync()
    {
        if (Meal.IsNew) _title = "Add Meal";
        else _title = Meal.Name;
        return base.OnParametersSetAsync();
    }

    private async Task OnVisibleChamged(bool visible)
    {
        await VisibleChanged.InvokeAsync(visible);
    }

    private async Task OnClickCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }

    private async Task OnClickSave()
    {
        bool result = false;

        if (Meal.IsNew)
        {
            result = await _mealService.AddAsync(Meal) > 0;
        }
        else
        {
            result = await _mealService.UpdateAsync(Meal);
        }

        if (result)
        {
            _updateService.NotifiyComponentUpdate(Meal);
            await MealChanged.InvokeAsync(Meal);
            await OnClickCancel();
        }
    }

    private void OnFoodItemChanged()
    {
        if (!Meal.FoodItems.Contains(_selectedFood)) Meal.FoodItems.Add(_selectedFood);
    }

    private void OnFoodItemDeleted(FoodItem foodItem)
    {
        if (Meal.FoodItems.Contains(foodItem)) Meal.FoodItems.Remove(foodItem);
    }
}
