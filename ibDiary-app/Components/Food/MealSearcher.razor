@inherits InputBase<Meal?>
@inject MealClientService _mealService

<div class="searcher-preview meal-searcher-preview">
    <button @onclick="@OnClickSearch">
        <p>Search Meal</p>
        <span class="material-symbols-outlined">search</span>
    </button>
    @if (EditContext != null && ValueExpression != null)
    {
        var messages = EditContext.GetValidationMessages(FieldIdentifier.Create(ValueExpression)).ToList();
        if (messages.Count > 0)
        {
            <div class="validation-error">
                @foreach (var error in messages)
                {
                    <p>@error</p>
                }
            </div>
        }
    }
    @if (null != CurrentValue)
    {
        @if (ShowSelected && !CurrentValue.IsNew)
        {
            <MealSmallCard Meal="@CurrentValue" DeleteClicked="@DeleteClicked" />
        }
    }
</div>

<Popup Visible="@_popupVisible" VisibleChanged="@OnVisibleChanged" Title="Search Meals">
    <div class="meal-searcher">
        <div>
            <IbdTextInput @bind-Value="@_searchString" @bind-Value:after="@OnSearchInputChanged" Title="Search Meals" />
            <button @onclick="@OnClickAdd">
                <span class="material-symbols-outlined">add</span>
            </button>
        </div>
        @if (_suggestedMeals.Count > 0)
        {
            <div>
                @foreach (var meal in _suggestedMeals)
                {
                    <MealSmallCard Meal="meal" MealClicked="@OnMealClicked" />
                }
                <button @onclick="@OnShowMoreClicked">
                    Show More
                </button>
            </div>
        }
    </div>

    <MealViewer Meal="@_newMeal" MealChanged="@OnNewMealChanged" @bind-Visible="@_newMealVisible"/>
</Popup>

@code {
    [Parameter] public bool ShowSelected { get; set; } = false;
    private List<Meal> _suggestedMeals = [];
    private List<Meal> _allMeals = [];
    private string _searchString = string.Empty;
    private bool _popupVisible = false;
    private int _showCount = 5;
    private Meal _newMeal = new();
    private bool _newMealVisible = false;

    protected override bool TryParseValueFromString(string? value, out Meal? result, out string validationErrorMessage)
    {
        result = null;
        validationErrorMessage = string.Empty;
        return false;
    }

    protected override async Task OnInitializedAsync()
    {
        _allMeals = await _mealService.GetAllAsync();
        _suggestedMeals = _allMeals.Take(_showCount).ToList();
        await base.OnInitializedAsync();
    }

    private void OnSearchInputChanged()
    {
        _suggestedMeals = _allMeals.Where(x => x.Name.Contains(_searchString, StringComparison.InvariantCultureIgnoreCase)).Take(_showCount).ToList();
    }

    private async Task OnMealClicked(Meal meal)
    {
        CurrentValue = meal;
        await ValueChanged.InvokeAsync(CurrentValue);
        StateHasChanged();
        _searchString = string.Empty;
        _suggestedMeals = _allMeals.Take(_showCount).ToList();
        _popupVisible = false;
    }

    private void OnVisibleChanged(bool visible)
    {
        _popupVisible = visible;
    }

    private void OnClickSearch()
    {
        _popupVisible = true;
    }

    private async Task DeleteClicked(Meal meal)
    {
        CurrentValue = null;
        await ValueChanged.InvokeAsync(CurrentValue);
    }

    private void OnShowMoreClicked()
    {
        _showCount = _showCount + 5;
        OnSearchInputChanged();
    }

    private void OnClickAdd()
    {
        _newMeal = new();
        _newMealVisible = true;
    }

    private async Task OnNewMealChanged(Meal meal)
    {
        _allMeals = await _mealService.GetAllAsync();
        _newMeal = new();
        OnSearchInputChanged();
    }
}
