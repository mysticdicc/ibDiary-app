@inherits InputBase<FoodItem?>
@inject FoodItemClientService _foodService

<div class="searcher-preview food-searcher-preview">
    <button @onclick="@OnClickSearch">
        <p>Search Food</p>
        <span class="material-symbols-outlined">search</span>
    </button>
    @if (EditContext != null && ValueExpression != null)
    {
        var messages = EditContext.GetValidationMessages(FieldIdentifier.Create(ValueExpression)).ToList();
        if (messages.Count > 0)
        {
            <div class="validation-error">
                @foreach (var error in messages)
                {
                    <p>@error</p>
                }
            </div>
        }
    }
    @if (null != CurrentValue)
    {
        @if (ShowSelected && !CurrentValue.IsNew)
        {
            <FoodItemSmallCard Food="@CurrentValue" DeleteClicked="@DeleteClicked" />
        }
    }
</div>

<Popup Visible="@_popupVisible" VisibleChanged="@OnVisibleChanged" Title="Search Food">
    <div class="food-item-searcher">
        <div>
            <IbdTextInput @bind-Value="@_searchString" @bind-Value:after="@OnSearchInputChanged" Title="Search Food Items" />
            <button @onclick="@OnClickAdd">
                <span class="material-symbols-outlined">add</span>
            </button>
        </div>
        @if (_suggestedFoods.Count > 0)
        {
            <div>
                @foreach (var food in _suggestedFoods)
                {
                    <FoodItemSmallCard Food="food" FoodClicked="@OnFoodClicked" />
                }
                <button @onclick="@OnShowMoreClicked">
                    Show More
                </button>
            </div>
        }
    </div>

    <FoodItemViewer Food="@_newFood" FoodChanged="@OnNewFoodChanged" @bind-Visible="@_newFoodVisible" />
</Popup>

@code {
    [Parameter] public bool ShowSelected { get; set; } = false;
    private List<FoodItem> _suggestedFoods = [];
    private List<FoodItem> _allFoods = [];
    private string _searchString = string.Empty;
    private bool _popupVisible = false;
    private int _showCount = 5;
    private FoodItem _newFood = new();
    private bool _newFoodVisible = false;

    protected override bool TryParseValueFromString(string? value, out FoodItem? result, out string validationErrorMessage)
    {
        result = null;
        validationErrorMessage = string.Empty;
        return false;
    }

    protected override void OnParametersSet()
    {
        if (EditContext != null)
        {
            EditContext.OnValidationStateChanged += HandleValidationStateChanged;
        }
        base.OnParametersSet();
    }

    private void HandleValidationStateChanged(object? sender, ValidationStateChangedEventArgs e)
    {
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        _allFoods = await _foodService.GetAllAsync();
        _suggestedFoods = _allFoods.Take(_showCount).ToList();
        await base.OnInitializedAsync();
    }

    private void OnSearchInputChanged()
    {
        _suggestedFoods = _allFoods.Where(x => x.Name.Contains(_searchString, StringComparison.InvariantCultureIgnoreCase)).Take(_showCount).ToList();
    }

    private async Task OnFoodClicked(FoodItem food)
    {
        CurrentValue = food;
        await ValueChanged.InvokeAsync(food);
        _searchString = string.Empty;
        _suggestedFoods = _allFoods.Take(_showCount).ToList();
        _popupVisible = false;
    }

    private void OnVisibleChanged(bool visible)
    {
        _popupVisible = visible;
    }

    private void OnClickSearch()
    {
        _popupVisible = true;
    }

    private async Task DeleteClicked(FoodItem food)
    {
        CurrentValue = null;
        await ValueChanged.InvokeAsync(CurrentValue);
    }

    private void OnShowMoreClicked()
    {
        _showCount = _showCount + 5;
        OnSearchInputChanged();
    }

    private async Task OnNewFoodChanged(FoodItem food)
    {
        _allFoods = await _foodService.GetAllAsync();
        _newFood = new();
        OnSearchInputChanged();
    }

    private void OnClickAdd()
    {
        _newFood = new();
        _newFoodVisible = true;
    }
}
