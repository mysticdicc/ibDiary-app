@inject FoodItemReportClientService _foodReportService
@inject ComponentUpdateService _updateService

<Popup Visible="@Visible" VisibleChanged="@VisibleChanged" Title="Food Report">
    <EditForm Model="@_report" OnValidSubmit="@OnClickSave">
        <DataAnnotationsValidator />

        <div class="food-item-report-viewer">
            <div>
                <FoodSearcher @bind-Value="@_report.FoodItem" ShowSelected="true" />
            </div>
            <div>
                <IbdDateTimeInput @bind-Value="@_report.AteFoodAtLocal" Title="Ate At" />
            </div>
            <div>
                <IbdTextArea @bind-Value="@_report.Notes" Title="Notes" />
            </div>
            <div>
                <button type="button" @onclick="@OnClickCancel">
                    Cancel
                </button>
                <button type="submit">
                    Save
                </button>
            </div>
        </div>
    </EditForm>
</Popup>


@code {
    [Parameter] required public FoodItemReportDto Report { get; set; }
    [Parameter] public EventCallback<FoodItemReportDto> ReportChanged { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    private FoodItemReportDto _report = new();

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_report, Report)) _report = Report;
        base.OnParametersSet();
    }

    private async Task OnVisibleChamged(bool visible)
    {
        await VisibleChanged.InvokeAsync(visible);
    }

    private async Task OnClickCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }

    private async Task OnClickSave()
    {
        bool result = false;

        if (_report.IsNew)
        {
            result = await _foodReportService.AddAsync(_report) > 0;
        }
        else
        {
            result = await _foodReportService.UpdateAsync(_report);
        }

        if (result)
        {
            _updateService.NotifiyComponentUpdate(_report);
            await ReportChanged.InvokeAsync(_report);
            await OnClickCancel();
        }
    }
}
