@inject ComponentUpdateService _updateService
@inject DateLocalisationService _dateService

@if (HasOwnControl)
{
    <div class="new-item-container">
        <button @onclick="@OnClickAdd">
            <span class="material-symbols-outlined">add</span>
        </button>
    </div>
}

<Popup Visible="@Visible" VisibleChanged="@OnVisibleChamged" Title="Add New">
    <div class="new-item-popup">
        <div>
            <header>
                <h2>Items</h2>
            </header>
            <button @onclick="@MedicineClicked">Create Medicine</button>
            <button @onclick="@SymptomClicked">Create Symptom</button>
            <button @onclick="@FoodClicked">Create Food Item</button>
            <button @onclick="@MealClicked">Create Meal</button>
        </div>
        <div>
            <header>
                <h2>Reports</h2>
            </header>
            <button @onclick="@MedicineReportClicked">Create Medicine Report</button>
            <button @onclick="@SymptomReportClicked">Create Symptom Report</button>
            <button @onclick="@FoodReportClicked">Create Food Report</button>
            <button @onclick="@MealReportClicked">Create Meal Report</button>
        </div>
    </div>
</Popup>

<CalendarUpdateViewerHost @ref="_viewerHost"/>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback<ICalendarUpdate> ItemChanged { get; set; }
    [Parameter] public bool HasOwnControl { get; set; } = true;
    private CalendarUpdateViewerHost? _viewerHost;

    private async Task OnVisibleChamged(bool visible)
    {
        await VisibleChanged.InvokeAsync(visible);
    }

    private void MedicineClicked()
    {
        _viewerHost?.OpenCalendarUpdate(new MedicineDto(_dateService.GetCurrentLocalTime()));
    }

    private void MedicineReportClicked()
    {
        _viewerHost?.OpenCalendarUpdate(new MedicineReportDto(_dateService.GetCurrentLocalTime()));
    }

    private void SymptomClicked()
    {
        _viewerHost?.OpenCalendarUpdate(new SymptomDto(_dateService.GetCurrentLocalTime()));
    }

    private void SymptomReportClicked()
    {
        _viewerHost?.OpenCalendarUpdate(new SymptomReportDto(_dateService.GetCurrentLocalTime()));
    }

    private void FoodClicked()
    {
        _viewerHost?.OpenCalendarUpdate(new FoodItemDto(_dateService.GetCurrentLocalTime()));
    }

    private void FoodReportClicked()
    {
        _viewerHost?.OpenCalendarUpdate(new FoodItemReportDto(_dateService.GetCurrentLocalTime()));
    }

    private void MealClicked()
    {
        _viewerHost?.OpenCalendarUpdate(new MealDto(_dateService.GetCurrentLocalTime()));
    }

    private void MealReportClicked()
    {
        _viewerHost?.OpenCalendarUpdate(new MealReportDto(_dateService.GetCurrentLocalTime()));
    }

    private async Task OnClickAdd()
    {
        Visible = true;
        await VisibleChanged.InvokeAsync(Visible);
    }

    private async Task OnItemChanged(ICalendarUpdate item)
    {
        await ItemChanged.InvokeAsync(item);
        _updateService.NotifiyComponentUpdate(item);
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }
}
