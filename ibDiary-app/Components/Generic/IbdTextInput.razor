<div class="ibd-text-input ibd-input">
    @if (_headerVisible)
    {
        <p>@Title</p>
    }
    @if (ReadOnly)
    {
        <input type="text" value="@Value" placeholder="@Title" readonly/>
    }
    else
    {
        <input type="text" value="@Value" @onchange="@OnInputChanged" placeholder="@Title"/>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    private bool _headerVisible = false;

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        if (e.Value is not string value) return;

        if (string.IsNullOrWhiteSpace(value)) _headerVisible = false;
        else _headerVisible = true;

        Value = value;
        await ValueChanged.InvokeAsync(Value);
    }
}
