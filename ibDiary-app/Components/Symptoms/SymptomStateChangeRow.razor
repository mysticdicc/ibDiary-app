<div class="symptom-state-change">
    <div class="left">
        <p>@StateChange.ChangedAtLocalDate</p>
    </div>
    <div class="right">
        @foreach (var update in StateChange.GetCalendarUpdate())
        {
            <p>@update</p>
        }
    </div>
</div>

@code {
    [Parameter] required public SymptomStateChangeDto StateChange { get; set; }
}
