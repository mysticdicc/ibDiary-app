@inject SymptomReportClientService _symDbService
@inject ComponentUpdateService _updateService

<Popup Visible="@Visible" VisibleChanged="@OnVisibleChamged" Title="Symptom Report">
    <EditForm Model="@_report" OnValidSubmit="@OnClickSave">
        <DataAnnotationsValidator />

        <div class="symptom-report-viewer">
            <div>
                <SymptomSearcher @bind-Value="@_report.Symptom" ShowSelected="true" />
            </div>
            <div>
                @if (null != _report.Medication)
                {
                    <MedicineSmallCard Medicine="@_report.Medication" />
                }
                else
                {

                }
            </div>
            <div>
                <IbdIntInput @bind-Value="@_report.Severity" Title="Severity" />
            </div>
            <div>
                <IbdTextArea @bind-Value="@_report.Notes" Title="Notes" />
            </div>
            <div>
                <IbdDateTimeInput @bind-Value="@_report.SubmittedForLocal" Title="Submitted For" />
            </div>
            <div>
                <button type="button" @onclick="@OnClickCancel">
                    Cancel
                </button>
                <button type="submit">
                    Save
                </button>
            </div>
        </div>
    </EditForm>
</Popup>

@code {
    [Parameter] required public SymptomReportDto SymptomReport { get; set; }
    [Parameter] public EventCallback<SymptomReportDto> SymptomReportChanged { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    private SymptomReportDto _report = new();
    
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_report, SymptomReport)) _report = SymptomReport;
        base.OnParametersSet();
    }

    private async Task OnClickCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }

    private async Task OnClickSave()
    {
        bool result = false;

        if (_report.Id == 0)
        {
            result = await _symDbService.AddAsync(_report) > 0;
        }
        else
        {
            result = await _symDbService.UpdateAsync(_report);
        }

        if (result)
        {
            _updateService.NotifiyComponentUpdate(_report);
            await SymptomReportChanged.InvokeAsync(_report);
            await OnClickCancel();
        }
    }

    private async Task OnVisibleChamged(bool visible)
    {
        await VisibleChanged.InvokeAsync(visible);
    }
}
