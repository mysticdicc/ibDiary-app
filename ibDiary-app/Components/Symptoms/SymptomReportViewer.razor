@inject SymptomReportClientService _symDbService
@inject ComponentUpdateService _updateService

<Popup Visible="@Visible" VisibleChanged="@OnVisibleChamged" Title="Symptom Report">
    <EditForm Model="@SymptomReport" OnValidSubmit="@OnClickSave">
        <DataAnnotationsValidator />

        <div class="symptom-report-viewer">
            <div>
                <SymptomSearcher @bind-Value="@SymptomReport.Symptom" ShowSelected="true" />
            </div>
            <div>
                @if (null != SymptomReport.Medication)
                {
                    <MedicineSmallCard Medicine="@SymptomReport.Medication" />
                }
                else
                {

                }
            </div>
            <div>
                <IbdIntInput @bind-Value="@SymptomReport.Severity" Title="Severity" />
            </div>
            <div>
                <IbdTextArea @bind-Value="@SymptomReport.Notes" Title="Notes" />
            </div>
            <div>
                <IbdDateTimeInput @bind-Value="@SymptomReport.SubmittedFor" Title="Submitted For" />
            </div>
            <div>
                <button @onclick="@OnClickCancel">
                    Cancel
                </button>
                <button type="submit">
                    Save
                </button>
            </div>
        </div>
    </EditForm>
</Popup>

@code {
    [Parameter] required public SymptomReport SymptomReport { get; set; }
    [Parameter] public EventCallback<SymptomReport> SymptomReportChanged { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    private async Task OnClickCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }

    private async Task OnClickSave()
    {
        bool result = false;

        if (SymptomReport.Id == 0)
        {
            result = await _symDbService.AddAsync(SymptomReport) > 0;
        }
        else
        {
            result = await _symDbService.UpdateAsync(SymptomReport);
        }

        if (result)
        {
            _updateService.NotifiyComponentUpdate(SymptomReport);
            await SymptomReportChanged.InvokeAsync(SymptomReport);
            await OnClickCancel();
        }
    }

    private async Task OnVisibleChamged(bool visible)
    {
        await VisibleChanged.InvokeAsync(visible);
    }
}
