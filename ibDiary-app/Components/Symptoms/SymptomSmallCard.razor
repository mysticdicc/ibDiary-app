<div class="symptom-card small-card" @onclick="@OnClickRow">
    <header>
        <h3>@Symptom.Title</h3>
        <button @onclick="@OnDeleteClicked" @onclick:stopPropagation="true">
            <span class="material-symbols-outlined">delete</span>
        </button>
    </header>
    <div>
        <p>@Symptom.Description</p>
    </div>
    <div>
        <p>Started at: @DateOnly.FromDateTime(Symptom.StartedAtLocal)</p>
    </div>
    <div>
        <p>Added on: @Symptom.CreatedAtLocalDate</p>
        <button @onclick="@OnClickOpenReport" @onclick:stopPropagation="true">
            Create Report
            <span class="material-symbols-outlined">article</span>
        </button>
    </div>
</div>

<SymptomReportViewer SymptomReport="@_report" @bind-Visible="@_reportViewerVisible"/>

@code {
    [Parameter] required public SymptomDto Symptom { get; set; }
    [Parameter] public EventCallback<SymptomDto> SymptomClicked { get; set; }
    [Parameter] public EventCallback<SymptomDto> DeleteClicked { get; set; }
    private bool _reportViewerVisible = false;
    private SymptomReportDto _report = new();

    protected override void OnParametersSet()
    {
        _report = new(Symptom);
        base.OnParametersSet();
    }

    private async Task OnClickRow()
    {
        await SymptomClicked.InvokeAsync(Symptom);
    }

    private async Task OnClickOpenReport()
    {
        _reportViewerVisible = true;
    }

    private async Task OnDeleteClicked()
    {
        await DeleteClicked.InvokeAsync(Symptom);
    }
}
