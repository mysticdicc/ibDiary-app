@inject SymptomClientService _symDbService
@inject ComponentUpdateService _updateService
@inject DateLocalisationService _dateService

<Popup Visible="@Visible" VisibleChanged="@OnVisibleChamged" Title="@_title">
    <EditForm Model="@_symptom" OnValidSubmit="@OnClickSave">
        <DataAnnotationsValidator />

        <div class="symptom-viewer">
            @if (!_symptom.IsNew)
            {
                <div>
                    <button type="button" @onclick="@(() => ChangeTab("sym"))">
                        Medicine
                    </button>
                    <button type="button" @onclick="@(() => ChangeTab("his"))">
                        History
                    </button>
                </div>
            }
            @if (_symptomVisible)
            {
                <div>
                    <IbdTextInput @bind-Value="@_symptom.Title" Title="Name" />
                    <IbdCheckbox @bind-Value="@_symptom.Active" Title="Active" />
                </div>
                <div>
                    <IbdTextArea @bind-Value="@_symptom.Description" Title="Description" />
                </div>
                <div>
                    <IbdDateTimeInput @bind-Value="@_symptom.StartedAtLocal" Title="Started At" />
                </div>
            }
            @if (_historyVisible)
            {
                <div class="symptom-history">
                    <ScrollingCalendar FilterBarEnabled="false" Values="@_historyData" Filter="@_filter" />
                </div>
            }
            <div>
                <button type="button" @onclick="@OnClickCancel">
                    Cancel
                </button>
                <button type="submit">
                    Save
                </button>
            </div>
        </div>
    </EditForm>
</Popup>

@code {
    [Parameter] required public SymptomDto Symptom { get; set; }
    private SymptomDto _symptom = new();

    [Parameter] public EventCallback<SymptomDto> SymptomChanged { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    private string _title = string.Empty;
    private bool _symptomVisible = true;
    private bool _historyVisible = false;

    private List<CalendarDayDto> _historyData = [];
    private CalendarFilter _filter = new();

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_symptom, Symptom))
        {
            _symptom = Symptom;
            GenerateCalendarDays();
            StateHasChanged();
        }

        _title = _symptom.IsNew ? "Add Symptom" : _symptom.Title;
        base.OnParametersSet();
    }

    private void GenerateCalendarDays()
    {
        _historyData = [];

        var dates = _symptom.SymptomReports.Select(x => x.GetDate()).ToList();
        dates.AddRange(_symptom.StateChanges.Select(x => x.GetDate()).ToList());

        foreach (var date in dates.Distinct())
        {
            var day = new CalendarDayDto(date);

            var sympReports = _symptom.SymptomReports.Where(x => x.GetDate() == date).ToList();
            foreach (var report in sympReports)
            {
                if (!day.SymptomReports.Contains(report)) day.SymptomReports.Add(report);
            }

            var stateChanges = _symptom.StateChanges.Where(x => x.GetDate() == date).ToList();
            foreach (var sc in stateChanges)
            {
                if (!day.SymptomStateChanges.Contains(sc)) day.SymptomStateChanges.Add(sc);
            }

            if (date == _symptom.GetDate()) day.CreatedSymptoms.Add(_symptom);

            _historyData.Add(day);
        }

        _filter.ShowInactive = false;
    }

    private async Task OnClickCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }

    private async Task OnClickSave()
    {
        bool result = false;

        if (Symptom.Id == 0)
        {
            var id = await _symDbService.AddAsync(Symptom);
            result = id > 0;
        }
        else
        {
            result = await _symDbService.UpdateAsync(Symptom);
        }

        if (result)
        {
            _updateService.NotifiyComponentUpdate(Symptom);
            await SymptomChanged.InvokeAsync(Symptom);
            await OnClickCancel();
        }
    }

    private async Task OnVisibleChamged(bool visible)
    {
        await VisibleChanged.InvokeAsync(visible);
    }

    public void ChangeTab(string tab)
    {
        _symptomVisible = false;
        _historyVisible = false;

        switch (tab)
        {
            case "sym":
                _symptomVisible = true;
                break;
            case "his":
                _historyVisible = true;
                break;
        }
    }
}
