@inject SymptomClientService _symDbService
@inject ComponentUpdateService _updateService

<Popup Visible="@Visible" VisibleChanged="@OnVisibleChamged" Title="@_title">
    <div class="symptom-viewer">
        @if (!Symptom.IsNew && Symptom.StateChanges.Count > 0)
        {
            <div>
                <button @onclick="@(() => ChangeTab("sym"))">
                    Medicine
                </button>
                <button @onclick="@(() => ChangeTab("his"))">
                    History
                </button>
            </div>
        }
        @if (_symptomVisible)
        {
            <div>
                <IbdTextInput @bind-Value="@Symptom.Title" Title="Name" />
                <IbdCheckbox @bind-Value="@Symptom.Active" Title="Active" />
            </div>
            <div>
                <IbdTextArea @bind-Value="@Symptom.Description" Title="Description" />
            </div>
            <div>
                <IbdDateTimeInput @bind-Value="@Symptom.StartedAt" Title="Started At"/>
            </div>
        }
        @if (_historyVisible)
        {
            <div class="state-change-list">
                <header>
                    <h2>History</h2>
                </header>
                <div>
                    @foreach (var change in Symptom.StateChanges)
                    {
                        <SymptomStateChangeRow StateChange="change" />
                    }
                </div>
            </div>
        }
        <div>
            <button @onclick="@OnClickCancel">
                Cancel
            </button>
            <button @onclick="@OnClickSave">
                Save
            </button>
        </div>
    </div>
</Popup>

@code {
    [Parameter] required public Symptom Symptom { get; set; }
    [Parameter] public EventCallback<Symptom> SymptomChanged { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    private string _title = string.Empty;
    private bool _symptomVisible = true;
    private bool _historyVisible = false;

    protected override void OnParametersSet()
    {
        if (Symptom.IsNew) _title = "Add Symptom";
        else _title = $"{Symptom.Title}";
        base.OnParametersSet();
    }

    private async Task OnClickCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }

    private async Task OnClickSave()
    {
        bool result = false;

        if (Symptom.Id == 0)
        {
            var id = await _symDbService.AddAsync(Symptom);
            result = id > 0;
        }
        else
        {
            result = await _symDbService.UpdateAsync(Symptom);
        }

        if (result)
        {
            _updateService.NotifiyComponentUpdate(Symptom);
            await SymptomChanged.InvokeAsync(Symptom);
            await OnClickCancel();
        }
    }

    private async Task OnVisibleChamged(bool visible)
    {
        await VisibleChanged.InvokeAsync(visible);
    }

    public void ChangeTab(string tab)
    {
        _symptomVisible = false;
        _historyVisible = false;

        switch (tab)
        {
            case "sym":
                _symptomVisible = true;
                break;
            case "his":
                _historyVisible = true;
                break;
        }
    }
}
