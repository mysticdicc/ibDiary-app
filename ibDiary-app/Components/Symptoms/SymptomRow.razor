<div class="symptom-row" @onclick="@OnClickRow">
    <div>@Symptom.Title</div>
    <div>@Symptom.Description</div>
</div>

@code {
    [Parameter] required public Symptom Symptom { get; set; }
    [Parameter] public EventCallback<Symptom> SymptomClicked { get; set; }

    private async Task OnClickRow()
    {
        await SymptomClicked.InvokeAsync(Symptom);
    }
}
