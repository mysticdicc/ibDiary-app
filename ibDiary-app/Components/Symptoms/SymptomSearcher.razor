@inherits InputBase<Symptom?>
@inject SymptomClientService _sympDbService

<div class="searcher-preview symptom-searcher-preview">
    <button @onclick="@OnClickSearch">
        <p>Search Symptoms</p>
        <span class="material-symbols-outlined">search</span>
    </button>
    @if (EditContext != null && ValueExpression != null)
    {
        var messages = EditContext.GetValidationMessages(FieldIdentifier.Create(ValueExpression)).ToList();
        if (messages.Count > 0)
        {
            <div class="validation-error">
                @foreach (var error in messages)
                {
                    <p>@error</p>
                }
            </div>
        }
    }
    @if (null != CurrentValue)
    {
        @if (ShowSelected && !CurrentValue.IsNew)
        {
            <SymptomSmallCard Symptom="@CurrentValue" DeleteClicked="@SymptomDeleteClicked" />
        }
    }
</div>

<Popup Visible="@_popupVisible" VisibleChanged="@OnVisibleChanged" Title="Search Symptoms">
    <div class="symptom-searcher">
        <div>
            <IbdTextInput @bind-Value="@_searchString" @bind-Value:after="@OnSearchInputChanged" Title="Search Symptoms" />
            <button @onclick="@OnClickAdd">
                <span class="material-symbols-outlined">add</span>
            </button>
        </div>
        @if (_suggestedSymptoms.Count > 0)
        {
            <div>
                @foreach (var symptom in _suggestedSymptoms)
                {
                    <SymptomSmallCard Symptom="symptom" SymptomClicked="@OnSymptomClicked" />
                }
                <button @onclick="@OnShowMoreClicked">
                    Show More
                </button>
            </div>
        }
    </div>

    <SymptomViewer Symptom="@_newSymptom" SymptomChanged="@OnNewSymptomChanged" @bind-Visible="@_newSymptomVisible"/>
</Popup>


@code {
    [Parameter] public bool ShowSelected { get; set; } = false;
    private List<Symptom> _allSymptoms = [];
    private List<Symptom> _suggestedSymptoms = [];
    private string _searchString = string.Empty;
    private bool _popupVisible = false;
    private int _showCount = 5;
    private Symptom _newSymptom = new();
    private bool _newSymptomVisible = false;

    protected override bool TryParseValueFromString(string? value, out Symptom? result, out string validationErrorMessage)
    {
        result = null;
        validationErrorMessage = string.Empty;
        return false;
    }

    protected override async Task OnInitializedAsync()
    {
        _allSymptoms = await _sympDbService.GetAllAsync();
        _suggestedSymptoms = _allSymptoms.Take(_showCount).ToList();
        await base.OnInitializedAsync();
    }

    private void OnSearchInputChanged()
    {
        _suggestedSymptoms = _allSymptoms.Where(x => x.Title.Contains(_searchString, StringComparison.CurrentCultureIgnoreCase)).Take(_showCount).ToList();
    }

    private async Task OnSymptomClicked(Symptom symptom)
    {
        CurrentValue = symptom;
        await ValueChanged.InvokeAsync(CurrentValue);
        _searchString = string.Empty;
        _suggestedSymptoms = _allSymptoms.Take(_showCount).ToList();
        _popupVisible = false;
    }

    private void OnVisibleChanged(bool visible)
    {
        _popupVisible = visible;
    }

    private void OnClickSearch()
    {
        _popupVisible = true;
    }

    private async Task SymptomDeleteClicked()
    {
        CurrentValue = null;
        await ValueChanged.InvokeAsync(null);
    }

    private void OnShowMoreClicked()
    {
        _showCount = _showCount + 5;
        OnSearchInputChanged();
    }

    private async Task OnNewSymptomChanged(Symptom symptom)
    {
        _allSymptoms = await _sympDbService.GetAllAsync();
        _newSymptom = new();
        OnSearchInputChanged();
    }

    private void OnClickAdd()
    {
        _newSymptom = new();
        _newSymptomVisible = true;
    }
}
