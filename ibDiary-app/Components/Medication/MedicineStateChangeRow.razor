<div class="medicine-state-change">
    <div class="left">
        <p>@StateChange.ChangedAtLocalDate</p>
    </div>
    <div class="right">
        @foreach (var update in StateChange.GetCalendarUpdate())
        {
            <p>@update</p>
        }
    </div>
</div>

@code {
    [Parameter] required public MedicineStateChangeDto StateChange { get; set; }
}
