@inject MedicineReportClientService _medDbService
@inject ComponentUpdateService _updateService

<Popup Visible="@Visible" VisibleChanged="@OnVisibleChamged" Title="Medicine Report">
    <EditForm Model="@_report" OnValidSubmit="@OnClickSave">
        <DataAnnotationsValidator />

        <div class="medicine-report-viewer">
            <div>
                <MedicineSearcher @bind-Value="@_report.Medicine" ShowSelected="true" />
            </div>
            <div>
                <IbdDateTimeInput Title="Taken At" @bind-Value="@_report.MedicineTakenAt" />
                <IbdCheckbox @bind-Value="@_report.MedicineTaken" Title="Taken" />
            </div>
            <div>
                <IbdTextArea Title="Notes" @bind-Value="@_report.Notes" />
            </div>
            <div>
                <button type="button" @onclick="@OnClickCancel">
                    Cancel
                </button>
                <button type="submit">
                    Save
                </button>
            </div>
        </div>
    </EditForm>
</Popup>

@code {
    [Parameter] required public MedicineReport MedicineReport { get; set; }
    [Parameter] required public EventCallback<MedicineReport> MedicineReportChanged { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    private MedicineReport _report = new();
    private MedicineReport? _sourceReport;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_sourceReport, MedicineReport))
        {
            _sourceReport = MedicineReport;
            _report = MedicineReport.Clone();
        }
        base.OnParametersSet();
    }

    private async Task OnClickCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }

    private async Task OnClickSave()
    {
        bool result = false;

        if (_report.IsNew)
        {
            result = await _medDbService.AddAsync(_report) > 0;
        }
        else
        {
            result = await _medDbService.UpdateAsync(_report);
        }

        if (result)
        {
            _updateService.NotifiyComponentUpdate(_report);
            await MedicineReportChanged.InvokeAsync(_report);
            await OnClickCancel();
        }
    }

    private async Task OnVisibleChamged(bool visible)
    {
        await VisibleChanged.InvokeAsync(visible);
    }
}
