@inject MedicineReportClientService _medDbService
@inject ComponentUpdateService _updateService

<Popup Visible="@Visible" VisibleChanged="@OnVisibleChamged" Title="Medicine Report">
    <div class="medicine-report-viewer">
        <div>
            <MedicineSearcher Medicine="@MedicineReport.Medicine" MedicineChanged="@OnMedicineSelected" ShowSelected="true"/>
        </div>
        <div>
            <IbdDateTimeInput Title="Taken At" @bind-Value="@MedicineReport.MedicineTakenAt" />
            <IbdCheckbox @bind-Value="@MedicineReport.MedicineTaken" Title="Taken"/>
        </div>
        <div>
            <IbdTextArea Title="Notes" @bind-Value="@MedicineReport.Notes" />
        </div>
        <div>
            <button @onclick="@OnClickCancel">
                Cancel
            </button>
            <button @onclick="@OnClickSave">
                Save
            </button>
        </div>
    </div>
</Popup>

@code {
    [Parameter] required public MedicineReport MedicineReport { get; set; }
    [Parameter] required public EventCallback<MedicineReport> MedicineReportChanged { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    private async Task OnClickCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }

    private async Task OnClickSave()
    {
        bool result = false;

        if (MedicineReport.IsNew)
        {
            result = await _medDbService.AddAsync(MedicineReport) > 0;
        }
        else
        {
            result = await _medDbService.UpdateAsync(MedicineReport);
        }

        if (result)
        {
            _updateService.NotifiyComponentUpdate(MedicineReport);
            await MedicineReportChanged.InvokeAsync(MedicineReport);
            await OnClickCancel();
        }
    }

    private async Task OnVisibleChamged(bool visible)
    {
        await VisibleChanged.InvokeAsync(visible);
    }

    private void OnMedicineSelected(Medicine medicine)
    {
        if (!medicine.IsNew) MedicineReport.Medicine = medicine;
    }
}
