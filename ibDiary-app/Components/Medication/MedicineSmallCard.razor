<div class="medicine-card small-card" @onclick="@OnClickRow">
    <header>
        <h3>@Medicine.Name</h3>
        <button @onclick="@OnDeleteClicked" @onclick:stopPropagation="true">
            <span class="material-symbols-outlined">delete</span>
        </button>
    </header>
    <div>
        <p>Dose: @Medicine.Dose</p>
    </div>
    <div>
        <p>Prescribed at: @Medicine.PrescribedAtLocalDate</p>
    </div>
    <div>
        <p>Prescribed by: @Medicine.PrescribedBy</p>
        <button @onclick:stopPropagation="true" @onclick="@OnClickOpenReport">
            Create Report
            <span class="material-symbols-outlined">article</span>
        </button>
    </div>
</div>

<MedicineReportViewer MedicineReport="@_report" @bind-Visible="@_reportViewerVisible"/>

@code {
    [Parameter] required public MedicineDto Medicine { get; set; }
    [Parameter] public EventCallback<MedicineDto> MedicineClicked { get; set; }
    [Parameter] public EventCallback<MedicineDto> DeleteClicked { get; set; }
    private bool _reportViewerVisible = false;
    private MedicineReportDto _report = new();

    private async Task OnClickRow()
    {
        await MedicineClicked.InvokeAsync(Medicine);
    }

    private async Task OnClickOpenReport()
    {
        _report = new(Medicine, new(Medicine));
        _reportViewerVisible = true;
    }

    private async Task OnDeleteClicked()
    {
        await DeleteClicked.InvokeAsync(Medicine);
    }
}
