@inject MedicineClientService _medDbService

<div class="searcher-preview medicine-searcher-preview">
    <button @onclick="@OnClickSearch">
        <p>Search Medicine</p>
        <span class="material-symbols-outlined">search</span>
    </button>
    @if (ShowSelected && !Medicine.IsNew) 
    {
        <MedicineSmallCard Medicine="@Medicine" DeleteClicked="@DeleteClicked"/>
    }
</div>

<Popup Visible="@_popupVisible" VisibleChanged="@OnVisibleChanged" Title="Search Medicine">
    <div class="medicine-searcher">
        <div>
            <IbdTextInput Value="@_searchString" ValueChanged="@OnSearchInputChanged" Title="Search Medicine" />
        </div>
        @if (_suggestedMedicines.Count > 0)
        {
            <div>
                @foreach (var medicine in _suggestedMedicines)
                {
                    <MedicineSmallCard Medicine="medicine" MedicineClicked="@OnMedicineClicked" />
                }
            </div>
        }
    </div>
</Popup>


@code {
    [Parameter] public Medicine Medicine { get; set; } = new();
    [Parameter] public EventCallback<Medicine> MedicineChanged { get; set; }
    [Parameter] public bool ShowSelected { get; set; } = false;
    private List<Medicine> _suggestedMedicines = [];
    private List<Medicine> _allMedicines = [];
    private string _searchString = string.Empty;
    private bool _popupVisible = false;

    protected override async Task OnInitializedAsync()
    {
        _allMedicines = await _medDbService.GetAllAsync();
        _suggestedMedicines = _allMedicines.Take(5).ToList();
        await base.OnInitializedAsync();
    }

    private void OnSearchInputChanged(string value)
    {
        _searchString = value;
        _suggestedMedicines = _allMedicines.Where(x => x.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    private async Task OnMedicineClicked(Medicine medicine)
    {
        await MedicineChanged.InvokeAsync(medicine);
        _suggestedMedicines = _allMedicines.Take(5).ToList();
        _popupVisible = false;
    }

    private void OnVisibleChanged(bool visible)
    {
        _popupVisible = visible;
    }

    private void OnClickSearch()
    {
        _popupVisible = true;
    }

    private async Task DeleteClicked(Medicine medicine)
    {
        Medicine = new();
        await MedicineChanged.InvokeAsync(Medicine);
    }
}
