@inherits InputBase<Medicine?>
@inject MedicineClientService _medDbService

<div class="searcher-preview medicine-searcher-preview">
    <button @onclick="@OnClickSearch">
        <p>Search Medicine</p>
        <span class="material-symbols-outlined">search</span>
    </button>
    @if (EditContext != null && ValueExpression != null)
    {
        var messages = EditContext.GetValidationMessages(FieldIdentifier.Create(ValueExpression)).ToList();
        if (messages.Count > 0)
        {
            <div class="validation-error">
                @foreach (var error in messages)
                {
                    <p>@error</p>
                }
            </div>
        }
    }
    @if (null != CurrentValue)
    {
        @if (ShowSelected && !CurrentValue.IsNew)
        {
            <MedicineSmallCard Medicine="@CurrentValue" DeleteClicked="@DeleteClicked" />
        }
    }
</div>

<Popup Visible="@_popupVisible" VisibleChanged="@OnVisibleChanged" Title="Search Medicine">
    <div class="medicine-searcher">
        <div>
            <IbdTextInput @bind-Value="@_searchString" @bind-Value:after="@OnSearchInputChanged" Title="Search Medicine" />
        </div>
        @if (_suggestedMedicines.Count > 0)
        {
            <div>
                @foreach (var medicine in _suggestedMedicines)
                {
                    <MedicineSmallCard Medicine="medicine" MedicineClicked="@OnMedicineClicked" />
                }
            </div>
        }
    </div>
</Popup>


@code {
    [Parameter] public bool ShowSelected { get; set; } = false;
    private List<Medicine> _suggestedMedicines = [];
    private List<Medicine> _allMedicines = [];
    private string _searchString = string.Empty;
    private bool _popupVisible = false;

    protected override bool TryParseValueFromString(string? value, out Medicine? result, out string validationErrorMessage)
    {
        result = null;
        validationErrorMessage = string.Empty;
        return false;
    }

    protected override async Task OnInitializedAsync()
    {
        _allMedicines = await _medDbService.GetAllAsync();
        _suggestedMedicines = _allMedicines.Take(5).ToList();
        await base.OnInitializedAsync();
    }

    private void OnSearchInputChanged()
    {
        _suggestedMedicines = _allMedicines.Where(x => x.Name.Contains(_searchString, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    private async Task OnMedicineClicked(Medicine medicine)
    {
        CurrentValue = medicine;
        await ValueChanged.InvokeAsync(medicine);
        _searchString = string.Empty;
        _suggestedMedicines = _allMedicines.Take(5).ToList();
        _popupVisible = false;
    }

    private void OnVisibleChanged(bool visible)
    {
        _popupVisible = visible;
    }

    private void OnClickSearch()
    {
        _popupVisible = true;
    }

    private async Task DeleteClicked(Medicine medicine)
    {
        CurrentValue = null;
        await ValueChanged.InvokeAsync(null);
    }
}
