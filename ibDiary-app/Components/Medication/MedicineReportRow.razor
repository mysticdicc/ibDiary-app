<div class="medicine-report-row" @onclick="@OnClickRow">
    <p>@MedicineReport.Medicine.Name</p>
    <p>@MedicineReport.Dose</p>
    @if (null != MedicineReport.DueAt)
    {
        <p>@(MedicineReport.DueAt.DueAtLocal.ToString("d/M h:mm tt") ?? string.Empty)</p>
    }
    else
    {
        <p>@MedicineReport.MedicineTakenAtLocal.ToString("d/M h:mm tt")</p>
    }
</div>

<MedicineReportViewer MedicineReport="@MedicineReport" @bind-Visible="@_reportViewerVisible"/>

@code {
    [Parameter] required public MedicineReportDto MedicineReport { get; set; }
    [Parameter] public EventCallback<MedicineReportDto> MedicineReportClicked { get; set; }
    [Parameter] public bool ShouldCallback { get; set; } = false;
    private bool _reportViewerVisible = false;

    private async Task OnClickRow()
    {
        if (ShouldCallback) await MedicineReportClicked.InvokeAsync(MedicineReport);
        else _reportViewerVisible = true;
    }
}
