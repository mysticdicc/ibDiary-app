@inject MedicineClientService _medDbService;

<Popup Visible="@Visible" VisibleChanged="@OnVisibleChamged" Title="@_title">
    <div class="medicine-viewer">
        @if (!Medicine.IsNew && Medicine.StateChanges.Count > 0)
        {
            <div>
                <button @onclick="@(() => ChangeTab("med"))">
                    Medicine
                </button>
                <button @onclick="@(() => ChangeTab("his"))">
                    History
                </button>
            </div>
        }
        @if (_medicineVisible)
        {
            <div>
                <IbdTextInput @bind-Value="@Medicine.Name" Title="Name" />
                <IbdCheckbox @bind-Value="@Medicine.Active" Title="Active" />
            </div>
            <div>
                <IbdTextInput @bind-Value="@Medicine.Dose" Title="Dose" />
            </div>
            <div>
                <IbdTextInput @bind-Value="@Medicine.PrescribedBy" Title="Prescribed By" />
            </div>
            <div>
                <IbdDateTimeInput @bind-Value="@Medicine.PrescribedAt" Title="Prescribed At" />
            </div>
            <div>
                <IbdTextArea @bind-Value="@Medicine.Notes" Title="Notes" />
            </div>
            <div>
                <MedicineScheduleViewer @bind-MedicineSchedule="@Medicine.MedicineSchedule" />
            </div>
        }
        @if (_historyVisible)
        {
            <div class="state-change-list">
                <div>
                    @foreach (var change in Medicine.StateChanges)
                    {
                        <MedicineStateChangeRow StateChange="change" />
                    }
                </div>
            </div>
        }
        <div>
            <button @onclick="@OnClickCancel">
                Cancel
            </button>
            <button @onclick="@OnClickSave">
                Save
            </button>
        </div>
    </div>
</Popup>


@code {
    [Parameter] required public Medicine Medicine { get; set; }
    [Parameter] public EventCallback<Medicine> MedicineChanged { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    private string _title = string.Empty;
    private bool _medicineVisible = true;
    private bool _historyVisible = false;

    protected override void OnParametersSet()
    {
        if (Medicine.IsNew) _title = "Add Medicine";
        else _title = $"{Medicine.Name}";
        base.OnParametersSet();
    }

    private async Task OnClickCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }

    private async Task OnClickSave()
    {
        bool result = false;

        if (Medicine.Id == 0) 
        {
            result = await _medDbService.AddAsync(Medicine) > 0;
        }
        else
        {
            result = await _medDbService.UpdateAsync(Medicine);
        }

        if (result)
        {
            await MedicineChanged.InvokeAsync(Medicine);
            await OnClickCancel();
        }
    }

    public void ChangeTab(string tab)
    {
        _medicineVisible = false;
        _historyVisible = false;

        switch(tab)
        {
            case "med":
                _medicineVisible = true;
                break;
            case "his":
                _historyVisible = true;
                break;
        }
    }

    private async Task OnVisibleChamged(bool visible)
    {
        await VisibleChanged.InvokeAsync(visible);
    }
}
