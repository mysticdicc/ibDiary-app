@inject MedicineClientService _medDbService
@inject ComponentUpdateService _updateService

<Popup Visible="@Visible" VisibleChanged="@OnVisibleChamged" Title="@_title">
    <EditForm Model="@_medicine" OnValidSubmit="@OnClickSave">
        <DataAnnotationsValidator />

        <div class="medicine-viewer">
            @if (!_medicine.IsNew)
            {
                <div>
                    <button type="button" @onclick="@(() => ChangeTab("med"))">
                        Medicine
                    </button>
                    <button type="button" @onclick="@(() => ChangeTab("his"))">
                        History
                    </button>
                </div>
            }
            @if (_medicineVisible)
            {
                <div>
                    <IbdTextInput @bind-Value="@_medicine.Name" Title="Name" />
                    <IbdCheckbox @bind-Value="@_medicine.Active" Title="Active" />
                </div>
                <div>
                    <IbdTextInput @bind-Value="@_medicine.Dose" Title="Dose" />
                </div>
                <div>
                    <IbdTextInput @bind-Value="@_medicine.PrescribedBy" Title="Prescribed By" />
                </div>
                <div>
                    <IbdDateTimeInput @bind-Value="@_medicine.PrescribedAtLocal" Title="Prescribed At" />
                </div>
                <div>
                    <IbdTextArea @bind-Value="@_medicine.Notes" Title="Notes" />
                </div>
                <div>
                    <MedicineScheduleViewer @bind-MedicineSchedule="@_medicine.MedicineSchedule" />
                </div>
            }
            @if (_historyVisible)
            {
                <div class="medicine-history">
                    <ScrollingCalendar FilterBarEnabled="false" Values="@_historyData" Filter="@_filter" />
                </div>
            }
            <div>
                <button type="button" @onclick="@OnClickCancel">
                    Cancel
                </button>
                <button type="submit">
                    Save
                </button>
            </div>
        </div>
    </EditForm>
</Popup>


@code {
    [Parameter] required public MedicineDto Medicine { get; set; }
    private MedicineDto _medicine = new();

    [Parameter] public EventCallback<MedicineDto> MedicineChanged { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    private string _title = string.Empty;
    private bool _medicineVisible = true;
    private bool _historyVisible = false;

    private List<CalendarDayDto> _historyData = [];
    private CalendarFilter _filter = new();

    protected override void OnParametersSet()
    {
        if (Medicine.Id != _medicine.Id)
        {
            _medicine = Medicine;
            _title = _medicine.IsNew ? "Add Medicine" : _medicine.Name;
            GenerateCalendarDays();
            StateHasChanged();
        }

        base.OnParametersSet();
    }

    private void GenerateCalendarDays()
    {
        _historyData = [];

        var dates = _medicine.MedicineReports.Select(x => x.GetDate()).ToList();
        dates.AddRange(_medicine.StateChanges.Select(x => x.GetDate()).ToList());

        foreach (var date in dates.Distinct())
        {
            var day = new CalendarDayDto(date);

            var reports = _medicine.MedicineReports.Where(x => x.GetDate() == date).ToList();
            foreach (var report in reports)
            {
                if (!day.MedicineReports.Contains(report)) day.MedicineReports.Add(report);
            }

            var states = _medicine.StateChanges.Where(x => x.GetDate() == date).ToList();
            foreach (var state in states)
            {
                if (!day.MedicineStateChanges.Contains(state)) day.MedicineStateChanges.Add(state);
            }

            if (date == _medicine.GetDate()) day.CreatedMedicines.Add(_medicine);

            _historyData.Add(day);
        }

        _filter.ShowInactive = false;
    }

    private async Task OnClickCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }

    private async Task OnClickSave()
    {
        bool result = false;

        if (_medicine.Id == 0)
        {
            result = await _medDbService.AddAsync(_medicine) > 0;
        }
        else
        {
            result = await _medDbService.UpdateAsync(_medicine);
        }

        if (result)
        {
            _updateService.NotifiyComponentUpdate(_medicine);
            await MedicineChanged.InvokeAsync(_medicine);
            await OnClickCancel();
        }
    }

    public void ChangeTab(string tab)
    {
        _medicineVisible = false;
        _historyVisible = false;

        switch(tab)
        {
            case "med":
                _medicineVisible = true;
                break;
            case "his":
                _historyVisible = true;
                break;
        }
    }

    private async Task OnVisibleChamged(bool visible)
    {
        await VisibleChanged.InvokeAsync(visible);
    }
}
