<div class="medicine-schedule-viewer" @key="@MedicineSchedule.Id">
    <header>
        <p>Schedule</p>
        <button @onclick="@OnClickHelp">
            <span class="material-symbols-outlined">help</span>
        </button>
        <IbdSelect Options="@_typeOptions" Title="Schedule Type" @bind-Value="@_selectedType" @bind-Value:after="@OnTypeChanged" />
    </header>
    <div>
        @if (_helpVisible)
        {  
            @if (MedicineSchedule.Type == MedicineScheduleType.AsNeeded)
            {
                <p>
                    As Needed: This is for when you have medicine that you just take as an when you need it rather than on any kind of schedule.
                    You will never be prompted to create a report for these.
                </p>
            }
            else if (MedicineSchedule.Type == MedicineScheduleType.DailyLimit)
            {
                <p>
                    Number per Day: You set a total amount per day to take and the interval between them, you will be prompted to
                    create a report every time the interval is reached up to the total amount for the day.
                </p>
            }
            else if (MedicineSchedule.Type == MedicineScheduleType.Interval)
            {
                <p>
                    Interval: This is for when you have to take medicine on a set schedule (eg. every 4 hours). You will be prompted to create
                    a medicine report every time the interval is reached but there is no limit to the number of reports per day.
                </p>
            }
        }
    </div>
    @if (MedicineSchedule.Type == MedicineScheduleType.DailyLimit)
    {
        <div>
            <IbdDateTimeInput @bind-Value="@MedicineSchedule.StartedAt" Title="Start At" />
        </div>
        <div>
            <IbdIntInput @bind-Value="@MedicineSchedule.IntervalValue" Title="@_intervalTitle" />
            <IbdIntInput @bind-Value="@MedicineSchedule.AmountPerDay" Title="Total" />
        </div>
    }
    else if (MedicineSchedule.Type == MedicineScheduleType.Interval)
    {
        <div>
            <IbdSelect Options="@_scheduleOptions" Title="Interval Length" @bind-Value="@_selectedInterval" @bind-Value:after="@OnIntervalTypeChanged" />
            <IbdIntInput @bind-Value="@MedicineSchedule.IntervalValue" Title="@_intervalTitle" />
        </div>
    }
</div>

@code {
    [Parameter] required public MedicineSchedule MedicineSchedule { get; set; }
    [Parameter] public EventCallback<MedicineSchedule> MedicineScheduleChanged { get; set; }
    private string _intervalTitle = string.Empty;

    private IbdSelectOption? _selectedType;
    private List<IbdSelectOption> _typeOptions = [
        new("As Needed", MedicineScheduleType.AsNeeded),
        new("Number Per Day", MedicineScheduleType.DailyLimit),
        new("Interval", MedicineScheduleType.Interval)
    ];

    private IbdSelectOption? _selectedInterval;
    private List<IbdSelectOption> _scheduleOptions = [
        new("Minutes", ScheduleIntervalType.Minutes),
        new("Hours", ScheduleIntervalType.Hours),
        new("Days", ScheduleIntervalType.Days),
        new("Months", ScheduleIntervalType.Months)
    ];

    private bool _helpVisible = false;

    protected override Task OnParametersSetAsync()
    {
        _selectedType = _typeOptions.FirstOrDefault(x => x.Value?.Equals(MedicineSchedule.Type) ?? false);
        _selectedInterval = _scheduleOptions.FirstOrDefault(x => x.Value?.Equals(MedicineSchedule.IntervalType) ?? false);
        UpdateIntervalTitle();
        return base.OnParametersSetAsync();
    }

    private async Task OnTypeChanged()
    {
        if (MedicineSchedule.Type == MedicineScheduleType.DailyLimit) MedicineSchedule.IntervalType = ScheduleIntervalType.Hours;
        UpdateIntervalTitle();
        await MedicineScheduleChanged.InvokeAsync(MedicineSchedule);
    }

    private async Task OnIntervalTypeChanged()
    {
        UpdateIntervalTitle();
        await MedicineScheduleChanged.InvokeAsync(MedicineSchedule);
    }

    private void UpdateIntervalTitle()
    {
        _intervalTitle = MedicineSchedule.IntervalType switch
        {
            ScheduleIntervalType.Minutes => "Minutes",
            ScheduleIntervalType.Hours => "Hours",
            ScheduleIntervalType.Days => "Days",
            ScheduleIntervalType.Months => "Months",
            _ => string.Empty
        };
    }

    private void OnClickHelp()
    {
        _helpVisible = !_helpVisible;
    }
}
