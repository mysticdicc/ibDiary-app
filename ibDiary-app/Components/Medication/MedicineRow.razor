<div class="medicine-row" @onclick="@OnClickRow">
    <div>@Medicine.Name</div>
    <div>@Medicine.Dose</div>
    <div>@Medicine.PrescribedBy</div>
</div>

@code {
    [Parameter] required public Medicine Medicine { get; set; }
    [Parameter] public EventCallback<Medicine> MedicineClicked { get; set; }

    private async Task OnClickRow()
    {
        await MedicineClicked.InvokeAsync(Medicine);
    }
}
