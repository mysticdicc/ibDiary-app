@inherits InputBase<int>

<div class="ibd-int-input">
    <p>@Title</p>
    <div>
        @if (ReadOnly)
        {
            <button type="button" class="readonly">
                <span class="material-symbols-icon">arrow_circle_down</span>
            </button>
        }
        else
        {
            <button type="button" @onclick="@OnClickDecrease" @onclick:stopPropagation="true">
                <span class="material-symbols-outlined">arrow_circle_down</span>
            </button>
        }
        <input type="number" value="@CurrentValue" readonly />
        @if (ReadOnly)
        {
            <button type="button" class="readonly">
                <span class="material-symbols-icon">arrow_circle_up</span>
            </button>
        }
        else
        {
            <button type="button" @onclick="@OnClickIncrease" @onclick:stopPropagation="true">
                <span class="material-symbols-outlined">arrow_circle_up</span>
            </button>
        }
    </div>
    @if (EditContext != null && ValueExpression != null)
    {
        var messages = EditContext.GetValidationMessages(FieldIdentifier.Create(ValueExpression)).ToList();
        if (messages.Count > 0)
        {
            <div class="validation-error">
                @foreach (var error in messages)
                {
                    <p>@error</p>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public int IncreaseCount { get; set; } = 1;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;

    protected override bool TryParseValueFromString(string? value, out int result, out string validationErrorMessage)
    {
        if (int.TryParse(value, out var parsedValue))
        {
            result = parsedValue;
            validationErrorMessage = string.Empty;
            return true;
        }

        result = 0;
        validationErrorMessage = "The value must be a valid integer.";
        return false;
    }

    private async Task OnValueChanged(ChangeEventArgs e)
    {
        int newValue = int.Parse(e.Value?.ToString() ?? "0");
        CurrentValue = newValue;
    }

    private async Task OnClickIncrease()
    {
        CurrentValue = CurrentValue + IncreaseCount;
    }

    private async Task OnClickDecrease()
    {
        if (CurrentValue == 0) return;
        var newValue = CurrentValue - IncreaseCount;
        if (newValue < 0) newValue = 0;
        CurrentValue = newValue;
    }
}