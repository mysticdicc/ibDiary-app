<div class="ibd-datetime-input ibd-input">
    <p>@Title</p>
    @if (ReadOnly)
    {
        <input type="text" value="@Value.ToString("yyyy-MM-ddTHH:mm")" readonly />
    }
    else
    {
        <input type="datetime-local" value="@Value.ToString("yyyy-MM-ddTHH:mm")" @onchange="@OnValueChanged" />
    }
</div>

@code {
    [Parameter] public DateTime Value { get; set; }
    [Parameter] public EventCallback<DateTime> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;

    private async Task OnValueChanged(ChangeEventArgs e)
    {
        if (e.Value is string value && DateTime.TryParse(value, out var dateTime))
        {
            Value = dateTime;
            await ValueChanged.InvokeAsync(Value);
        }
    }
}