@inherits InputBase<DateOnly>

<div class="ibd-datetime-input ibd-input">
    <p>@Title</p>
    @if (ReadOnly)
    {
        <input type="date" value="@CurrentValue" readonly />
    }
    else
    {
        <input type="date" value="@CurrentValue" @onchange="@OnInputChanged" />
    }
    @if (EditContext != null && ValueExpression != null)
    {
        var messages = EditContext.GetValidationMessages(FieldIdentifier.Create(ValueExpression)).ToList();
        if (messages.Count > 0)
        {
            <div class="validation-error">
                @foreach (var error in messages)
                {
                    <p>@error</p>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;

    protected override bool TryParseValueFromString(string? value, out DateOnly result, out string validationErrorMessage)
    {
        if (DateOnly.TryParse(value, out var parsedValue))
        {
            result = parsedValue;
            validationErrorMessage = string.Empty;
            return true;
        }

        result = default;
        validationErrorMessage = "The date is invalid.";
        return false;
    }

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        if (e.Value is string value && DateOnly.TryParse(value, out var dateTime))
        {
            CurrentValue = dateTime;
            await ValueChanged.InvokeAsync(CurrentValue);
        }
    }
}
