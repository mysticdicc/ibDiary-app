@inject NavigationManager NavManager

<div class="nav-menu-container">
    <header>
        <h1>IbDiary</h1>
    </header>
    <div>
        <button @onclick="@OnClickHome"><span class="material-symbols-outlined">home</span></button>
        <button @onclick="@OnClickOpenHistory">History</button>
        <button @onclick="@OnClickOpenSymptoms">Symptoms</button>
        <button @onclick="@OnClickOpenMedicine">Medicines</button>
        <button @onclick="@OnClickOpenSettings"><span class="material-symbols-outlined">settings</span></button>
    </div>
</div>

@code {
    private void OnClickHome()
    {
        NavManager.NavigateTo("/");
    }

    private void OnClickOpenSymptoms()
    {
        NavManager.NavigateTo("/symptoms");
    }

    private void OnClickOpenMedicine()
    {
        NavManager.NavigateTo("/medicines");
    }

    private void OnClickOpenHistory()
    {
        NavManager.NavigateTo("/history");
    }

    private void OnClickOpenSettings()
    {
        NavManager.NavigateTo("/settings");
    }
}