<div class="calendar-card">
    <header>
        @(Date.DayOfWeek.ToString()) @(Date.ToString("MMMM")) @(Date.Year.ToString())
    </header>
    <div>
        @if (null != Day)
        {
            if (_dayUpdates.Count == 0)
            {
                <p>No activity.</p>
            }
            else
            {
                foreach (var update in _dayUpdates)
                {
                    if (update is MedicineReport medReport)
                    {
                        <p>You took @medReport.Dose of @medReport.Medicine.Name at @(medReport.MedicineTakenAt.Hour):@(medReport.MedicineTakenAt.Minute.ToString("D2")).</p>
                    }
                    else if (update is MedicineStateChange medChange)
                    {
                        <MedicineStateChangeRow StateChange="@medChange" />
                    }
                    else if (update is Medicine medicine)
                    {
                        <p>You were prescribed @medicine.Dose of @medicine.Name by @(medicine.PrescribedBy).</p>
                    }
                    else if (update is SymptomReport sympReport)
                    {
                        <p>You reported that your @sympReport.Symptom.Title symptom was severity @sympReport.Severity at @sympReport.SubmittedFor.ToString("hh:mm").</p>
                    }
                    else if (update is SymptomStateChange sympChange)
                    {
                        <SymptomStateChangeRow StateChange="@sympChange" />
                    }
                    else if (update is Symptom symptom)
                    {
                        <p>You added @symptom.Title to your active symptoms.</p>
                    }
                }
            }

        }
        else
        {
            <p>No activity.</p>
        }
    </div>
</div>

@code {
    [Parameter] required public DateOnly Date { get; set; }
    [Parameter] public CalendarDay? Day { get; set; }
    private List<ICalendarUpdate> _dayUpdates = [];

    protected override Task OnParametersSetAsync()
    {
        _dayUpdates.Clear();

        if (null != Day)
        {
            _dayUpdates.AddRange(Day.SymptomStateChanges);
            _dayUpdates.AddRange(Day.CreatedSymptoms);
            _dayUpdates.AddRange(Day.SymptomReports);
            _dayUpdates.AddRange(Day.CreatedMedicines);
            _dayUpdates.AddRange(Day.MedicineStateChanges);
            _dayUpdates.AddRange(Day.MedicineReports);

            _dayUpdates = _dayUpdates.OrderByDescending(x => x.GetDate()).ToList();
        }
        else _dayUpdates = [];

        return base.OnParametersSetAsync();
    }
}
