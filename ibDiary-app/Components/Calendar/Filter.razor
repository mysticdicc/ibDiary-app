<div class="calendar-filter">
    <div>
        <header>
            <h3>Filter By</h3>
            <button @onclick="@OnClickReset">
                <span class="material-symbols-outlined">refresh</span>
            </button>
        </header>
        <div>
            <IbdCheckbox @bind-Value="@CalendarFilter.DateFilterEnabled" @bind-Value:after="@UpdateGeneral" Title="Date" />
            <IbdCheckbox @bind-Value="@CalendarFilter.MedicineFilterEnabled" @bind-Value:after="@UpdateGeneral" Title="Medicine" />
            <IbdCheckbox @bind-Value="@CalendarFilter.SymptomFilterEnabled" @bind-Value:after="@UpdateGeneral" Title="Symptom" />
        </div>
        <div>
            <IbdCheckbox @bind-Value="@CalendarFilter.FoodFilterEnabled" @bind-Value:after="@UpdateGeneral" Title="Food" />
            <IbdCheckbox @bind-Value="@CalendarFilter.MealFilterEnabled" @bind-Value:after="@UpdateGeneral" Title="Meal" />
        </div>
        @if (CalendarFilter.DateFilterEnabled)
        {
            <div>
                <IbdDateOnlyInput @bind-Value="@CalendarFilter.DateFilterFrom" @bind-Value:after="@UpdateGeneral" Title="Date From" />
                <IbdDateOnlyInput @bind-Value="@CalendarFilter.DateFilterTo" @bind-Value:after="@UpdateGeneral" Title="Date To" />
            </div>
        }
        @if (CalendarFilter.MedicineFilterEnabled)
        {
            <div>
                <MedicineSearcher @bind-Value="@CalendarFilter.Medicine" @bind-Value:after="@UpdateGeneral" ShowSelected="true" />
            </div>
        }
        @if (CalendarFilter.SymptomFilterEnabled)
        {
            <div>
                <SymptomSearcher @bind-Value="@CalendarFilter.Symptom" @bind-Value:after="@UpdateGeneral" ShowSelected="true" />
            </div>
        }
        @if (CalendarFilter.FoodFilterEnabled)
        {
            <div>
                <FoodSearcher @bind-Value="@CalendarFilter.Food" @bind-Value:after="@UpdateGeneral" ShowSelected="true" />
            </div>
        }
        @if (CalendarFilter.MealFilterEnabled)
        {
            <div>
                <MealSearcher @bind-Value="@CalendarFilter.Meal" @bind-Value:after="@UpdateGeneral" ShowSelected="true" />
            </div>
        }
    </div>
    <div>
        <header>
            <h3>Show/Hide</h3>
        </header>
        <div>
            <IbdCheckbox @bind-Value="@CalendarFilter.ShowInactive" @bind-Value:after="@UpdateGeneral" Title="Inactive" />
        </div>
        <div>
            <IbdCheckbox @bind-Value="@CalendarFilter.ShowAddedMedicines" @bind-Value:after="@UpdateGeneral" Title="Medicines" />
            <IbdCheckbox @bind-Value="@CalendarFilter.ShowMedicineReports" @bind-Value:after="@UpdateGeneral" Title="Medicine Reports" />
        </div>
        <div>
            <IbdCheckbox @bind-Value="@CalendarFilter.ShowAddedSymptoms" @bind-Value:after="@UpdateGeneral" Title="Symptoms" />
            <IbdCheckbox @bind-Value="@CalendarFilter.ShowSymptomReports" @bind-Value:after="@UpdateGeneral" Title="Symptom Reports" />
        </div>
        <div>
            <IbdCheckbox @bind-Value="@CalendarFilter.ShowAddedFoods" @bind-Value:after="@UpdateGeneral" Title="Foods" />
            <IbdCheckbox @bind-Value="@CalendarFilter.ShowFoodReports" @bind-Value:after="@UpdateGeneral" Title="Food Reports" />
        </div>
        <div>
            <IbdCheckbox @bind-Value="@CalendarFilter.ShowAddedMeals" @bind-Value:after="@UpdateGeneral" Title="Meals" />
            <IbdCheckbox @bind-Value="@CalendarFilter.ShowMealReports" @bind-Value:after="@UpdateGeneral" Title="Meal Reports" />
        </div>
    </div>
</div>

@code {
    [Parameter] public CalendarFilter CalendarFilter { get; set; } = new();
    [Parameter] public EventCallback<CalendarFilter> CalendarFilterChanged { get; set; }

    private async Task OnClickReset()
    {
        CalendarFilter = new();
        await CalendarFilterChanged.InvokeAsync(CalendarFilter);
    }

    private async Task UpdateGeneral()
    {
        await CalendarFilterChanged.InvokeAsync(CalendarFilter);
    }
}