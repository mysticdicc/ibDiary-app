<div class="calendar-filter">
    <div>
        <header>
            <h3>Filter By</h3>
            <button @onclick="@OnClickReset">
                <span class="material-symbols-outlined">refresh</span>
            </button>
        </header>
        <div>
            <IbdCheckbox Value="@CalendarFilter.DateFilterEnabled" ValueChanged="@UpdateDateFilterEnabled" Title="Date" />
            <IbdCheckbox Value="@CalendarFilter.MedicineFilterEnabled" ValueChanged="@UpdateMedicineFilterEnabled" Title="Medicine" />
            <IbdCheckbox Value="@CalendarFilter.SymptomFilterEnabled" ValueChanged="@UpdateSymptomFilterEnabled" Title="Symptom" />
        </div>
        <div>
            <IbdCheckbox Value="@CalendarFilter.FoodFilterEnabled" ValueChanged="@UpdateFoodFilterEnabled" Title="Food" />
            <IbdCheckbox Value="@CalendarFilter.MealFilterEnabled" ValueChanged="@UpdateMealFilterEnabled" Title="Meal" />
        </div>
        @if (CalendarFilter.DateFilterEnabled)
        {
            <div>
                <IbdDateOnlyInput Value="@CalendarFilter.DateFilterFrom" ValueChanged="@UpdateDateFilterFrom" Title="Date From" />
                <IbdDateOnlyInput Value="@CalendarFilter.DateFilterTo" ValueChanged="@UpdateDateFilterTo" Title="Date To" />
            </div>
        }
        @if (CalendarFilter.MedicineFilterEnabled)
        {
            <div>
                <MedicineSearcher @bind-Value="@CalendarFilter.Medicine" @bind-Value:after="@UpdateGeneral" ShowSelected="true" />
            </div>
        }
        @if (CalendarFilter.SymptomFilterEnabled)
        {
            <div>
                <SymptomSearcher @bind-Value="@CalendarFilter.Symptom" @bind-Value:after="@UpdateGeneral" ShowSelected="true" />
            </div>
        }
        @if (CalendarFilter.FoodFilterEnabled)
        {
            <div>
                <FoodSearcher @bind-Value="@CalendarFilter.Food" @bind-Value:after="@UpdateGeneral" ShowSelected="true" />
            </div>
        }
        @if (CalendarFilter.MealFilterEnabled)
        {
            <div>
                <MealSearcher @bind-Value="@CalendarFilter.Meal" @bind-Value:after="@UpdateGeneral" ShowSelected="true" />
            </div>
        }
    </div>
    <div>
        <header>
            <h3>Show/Hide</h3>
        </header>
        <div>
            <IbdCheckbox Value="@CalendarFilter.ShowInactive" ValueChanged="@UpdateShowInactive" Title="Inactive" />
        </div>
        <div>
            <IbdCheckbox Value="@CalendarFilter.ShowAddedMedicines" ValueChanged="@UpdateShowCreatedMedicines" Title="Medicines" />
            <IbdCheckbox Value="@CalendarFilter.ShowMedicineReports" ValueChanged="@UpdateShowMedicineReports" Title="Medicine Reports" />
        </div>
        <div>
            <IbdCheckbox Value="@CalendarFilter.ShowAddedSymptoms" ValueChanged="@UpdateShowAddedSymptoms" Title="Symptoms" />
            <IbdCheckbox Value="@CalendarFilter.ShowSymptomReports" ValueChanged="@UpdateShowSymptomReports" Title="Symptom Reports" />
        </div>
        <div>
            <IbdCheckbox Value="@CalendarFilter.ShowAddedFoods" ValueChanged="@UpdateShowAddedFoods" Title="Foods" />
            <IbdCheckbox Value="@CalendarFilter.ShowFoodReports" ValueChanged="@UpdateShowFoodReports" Title="Food Reports" />
        </div>
        <div>
            <IbdCheckbox Value="@CalendarFilter.ShowAddedMeals" ValueChanged="@UpdateShowAddedMeals" Title="Meals"/>
            <IbdCheckbox Value="@CalendarFilter.ShowMealReports" ValueChanged="@UpdateShowMealReports" Title="Meal Reports"/>
        </div>
    </div>
</div>

@code {
    [Parameter] public CalendarFilter CalendarFilter { get; set; } = new();
    [Parameter] public EventCallback OnFilterChanged { get; set; }

    private async Task UpdateDateFilterEnabled(bool value)
    {
        CalendarFilter.DateFilterEnabled = value;
        await OnFilterChanged.InvokeAsync();
    }

    private async Task UpdateMedicineFilterEnabled(bool value)
    {
        CalendarFilter.ChangeMedicineFilter(value);
        await OnFilterChanged.InvokeAsync();
    }

    private async Task UpdateSymptomFilterEnabled(bool value)
    {
        CalendarFilter.ChangeSymptomFilter(value);
        await OnFilterChanged.InvokeAsync();
    }

    private async Task UpdateFoodFilterEnabled(bool value)
    {
        CalendarFilter.ChangeFoodFilter(value);
        await OnFilterChanged.InvokeAsync();
    }

    private async Task UpdateMealFilterEnabled(bool value)
    {
        CalendarFilter.ChangeMealFilter(value);
        await OnFilterChanged.InvokeAsync();
    }

    private async Task UpdateDateFilterFrom(DateOnly value)
    {
        CalendarFilter.DateFilterFrom = value;
        await OnFilterChanged.InvokeAsync();
    }

    private async Task UpdateDateFilterTo(DateOnly value)
    {
        CalendarFilter.DateFilterTo = value;
        await OnFilterChanged.InvokeAsync();
    }

    private async Task UpdateShowInactive(bool value)
    {
        CalendarFilter.ShowInactive = value;
        await OnFilterChanged.InvokeAsync();
    }

    private async Task UpdateShowCreatedMedicines(bool value)
    {
        CalendarFilter.ShowAddedMedicines = value;
        await OnFilterChanged.InvokeAsync();
    }

    private async Task UpdateShowMedicineReports(bool value)
    {
        CalendarFilter.ShowMedicineReports = value;
        await OnFilterChanged.InvokeAsync();
    }

    private async Task UpdateShowAddedSymptoms(bool value)
    {
        CalendarFilter.ShowAddedSymptoms = value;
        await OnFilterChanged.InvokeAsync();
    }

    private async Task UpdateShowSymptomReports(bool value)
    {
        CalendarFilter.ShowSymptomReports = value;
        await OnFilterChanged.InvokeAsync();
    }

    private async Task UpdateShowAddedFoods(bool value)
    {
        CalendarFilter.ShowAddedFoods = value;
        await OnFilterChanged.InvokeAsync();
    }

    private async Task UpdateShowFoodReports(bool value)
    {
        CalendarFilter.ShowFoodReports = value;
        await OnFilterChanged.InvokeAsync();
    }

    private async Task UpdateShowAddedMeals(bool value)
    {
        CalendarFilter.ShowAddedMeals = value;
        await OnFilterChanged.InvokeAsync();
    }

    private async Task UpdateShowMealReports(bool value)
    {
        CalendarFilter.ShowMealReports = value;
        await OnFilterChanged.InvokeAsync();
    }

    private async Task OnClickReset()
    {
        CalendarFilter = new();
        await OnFilterChanged.InvokeAsync();
    }

    private async Task UpdateGeneral()
    {
        await OnFilterChanged.InvokeAsync();
    }
}