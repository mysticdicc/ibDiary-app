@inject FoodItemClientService _foodService
@inject MealClientService _mealService
@inject ConfirmationService _confirmService
@inject DateLocalisationService _dateService
@page "/foods"

<article class="food-page">
    <header>
        <button @onclick="@OnClickShowHelp">
            <span class="material-symbols-outlined">help</span>
        </button>
        <button @onclick="@OnClickAdd">
            <span class="material-symbols-outlined">add</span>
        </button>
    </header>
    <div class="food-list">
        <h2>Foods</h2>
        @if (_allFoods.Count > 0)
        {
            @foreach (var food in _allFoods)
            {
                <FoodItemSmallCard Food="food" FoodClicked="@OnFoodItemClicked" 
                    DeleteClicked="@OnClickDeleteFood"/>
            }
        }
        else
        {
            <p>You have not created any foods. Press the + button to get started.</p>
        }
        <h2>Meals</h2>
        @if (_allMeals.Count > 0)
        {
            @foreach (var meal in _allMeals)
            {
                <MealSmallCard Meal="meal" MealClicked="@OnMealClicked" 
                    DeleteClicked="@OnClickDeleteMeal"/>
            }
        }
        else
        {
            <p>You have not created any meals. Press the + button to get started.</p>
        }
    </div>
</article>

<FoodItemViewer Food="@_selectedFood" FoodChanged="@OnFoodItemChanged" @bind-Visible="@_foodViewerVisible"/>
<MealViewer Meal="@_selectedMeal" MealChanged="@OnMealChanged" @bind-Visible="@_mealViewerVisible"/>
<FoodHelpPopup @bind-Visible="@_helpVisible"/>

@code {
    private List<FoodItemDto> _allFoods = [];
    private FoodItemDto _selectedFood = new();
    private bool _foodViewerVisible = false;
    private List<MealDto> _allMeals = [];
    private MealDto _selectedMeal = new();
    private bool _mealViewerVisible = false;
    private bool _helpVisible = false;

    protected override async Task OnInitializedAsync()
    {
        _allFoods = await _foodService.GetAllAsync();
        _allMeals = await _mealService.GetAllAsync();
        await base.OnInitializedAsync();
    }

    private void OnFoodItemClicked(FoodItemDto item)
    {
        _selectedFood = item;
        _foodViewerVisible = true;
    }

    private void OnMealClicked(MealDto meal)
    {
        _selectedMeal = meal;
        _mealViewerVisible = true;
    }

    private async Task OnClickAdd()
    {
        var request = new ConfirmationRequest();
        request.Message = "Do you want to create a meal or a food item?";
        request.TrueOption = new(true, "Food Item");
        request.FalseOption = new(false, "Meal");
        var result = await _confirmService.ShowAsync(request);

        if (result.Result) 
        {
            _selectedFood = new(_dateService.GetCurrentLocalTime());
            _foodViewerVisible = true;
        }
        else
        {
            _selectedMeal = new(_dateService.GetCurrentLocalTime());
            _mealViewerVisible = true;
        }
    }

    private async Task OnClickDeleteFood(FoodItemDto food)
    {
        var request = new ConfirmationRequest();
        request.Message = $"Are you sure you want to delete {food.Name}?";
        request.TrueOption = new(true, "Yes");
        request.FalseOption = new(false, "No");
        var result = await _confirmService.ShowAsync(request);

        if (result.Result)
        {
            var success = await _foodService.DeleteAsync(food);
            if (success) await OnInitializedAsync();
        }
    }

    private async Task OnClickDeleteMeal(MealDto meal)
    {
        var request = new ConfirmationRequest();
        request.Message = $"Are you sure you want to delete {meal.Name}?";
        request.TrueOption = new(true, "Yes");
        request.FalseOption = new(false, "No");
        var result = await _confirmService.ShowAsync(request);

        if (result.Result)
        {
            var success = await _mealService.DeleteAsync(meal);
            if (success) await OnInitializedAsync();
        }
    }

    private async Task OnFoodItemChanged(FoodItemDto foodItem)
    {
        await OnInitializedAsync();
    }

    private async Task OnMealChanged(MealDto meal)
    {
        await OnInitializedAsync();
    }

    private void OnClickShowHelp()
    {
        _helpVisible = true;
    }
}
