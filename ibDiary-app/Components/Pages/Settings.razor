@page "/settings"
@implements IDisposable
@inject ComponentUpdateService _updateService
@inject MedicineClientService _medService
@inject MedicineStateChangeClientService _medStateChangeService
@inject MedicineReportClientService _medReportService
@inject SymptomClientService _sympService
@inject SymptomStateChangeClientService _sympStateChangeService
@inject SymptomReportClientService _sympReportService
@inject CalendarClientService _calService
@inject ClientNotificationService _notifier
@inject ConfirmationService _confirmService
@inject ScheduledNotificationClientService _notificationService
@inject AppSettings _settings
@inject DtoMappingService _dtoService
@using System.Text.Json

<article class="settings-page">
    <div>
        <header>
            <h2>Personal</h2>
        </header>
        <IbdSelect Options="@_timeZoneOptions" @bind-Value="@_selectTimeZone" @bind-Value:after="@OnTimeZoneChanged" Title="Time Zone"/>
    </div>
    <div>
        <header>
            <h2>Backups</h2>
        </header>
        <button @onclick="@OnClickDownloadBackup">Download Backup</button>
@*      <button>Upload Backup</button>
        <button>Download History</button> *@
    </div>
    <div>
        <header>
            <h2>Database</h2>
        </header>
        <button @onclick="@OnClickDeleteDatabase">Delete Database</button>
    </div>
    <div>
        <header>
            <h2>Notifications</h2>
        </header>
        <IbdCheckbox @bind-Value="@_settings.NotificationsEnabled" @bind-Value:after="@OnSettingsChanged" Title="Notifications Enabled" />
        @if (_settings.NotificationsEnabled)
        {
            <IbdIntInput @bind-Value="@_settings.MinutesBetweenNotifications" @bind-Value:after="@OnSettingsChanged" Title="Minutes Between Notifications" IncreaseCount="15"/>
            <IbdCheckbox @bind-Value="@_settings.MedicineReportNotificationsEnabled" @bind-Value:after="@OnSettingsChanged" Title="Medicine Report Notifications Enabled"/>
            <IbdCheckbox @bind-Value="@_settings.ScheduledNotificationsEnabled" @bind-Value:after="@OnSettingsChanged" Title="Scheduled Notifications" />
        }
        @if (_settings.ScheduledNotificationsEnabled)
        {
            <div>
                <h3>
                    Scheduled Notifications
                </h3>
                <button @onclick="@OnClickNewNotification">
                    <span class="material-symbols-outlined">add</span>
                </button>
            </div>
            @if (_notifications.Count == 0)
            {
                <p>You have no scheduled notifications, press the add button to create one.</p>
            }
            else
            {
                @foreach (var notification in _notifications)
                {
                    <ScheduledNotificationRow Notification="@notification" NotificationClicked="@OnNotificationClicked" />
                }
            }
        }
    </div>
</article>

<ScheduledNotificationViewer @bind-Notification="@_currentNotification" @bind-Visible="@_notificationViewerVisible"/>

@code {
    private List<ScheduledNotificationDto> _notifications = [];
    private ScheduledNotificationDto _currentNotification = new();
    private bool _notificationViewerVisible = false;
    private IbdSelectOption? _selectTimeZone;
    private readonly List<IbdSelectOption> _timeZoneOptions =
    [
            new("(UTC) UTC", "UTC"),
            new("(UTC+00:00) London", "Europe/London"),
            new("(UTC+01:00) Paris", "Europe/Paris"),
            new("(UTC+02:00) Athens", "Europe/Athens"),
            new("(UTC+03:00) Moscow", "Europe/Moscow"),
            new("(UTC+04:00) Dubai", "Asia/Dubai"),
            new("(UTC+05:30) India", "Asia/Kolkata"),
            new("(UTC+06:00) Dhaka", "Asia/Dhaka"),
            new("(UTC+07:00) Bangkok", "Asia/Bangkok"),
            new("(UTC+08:00) Beijing", "Asia/Shanghai"),
            new("(UTC+09:00) Tokyo", "Asia/Tokyo"),
            new("(UTC+10:00) Sydney", "Australia/Sydney"),
            new("(UTC+12:00) Auckland", "Pacific/Auckland"),
            new("(UTC-02:30) Newfoundland", "America/St_Johns"),
            new("(UTC-04:00) Atlantic Time", "America/Halifax"),
            new("(UTC-05:00) Eastern Time", "America/New_York"),
            new("(UTC-06:00) Central Time", "America/Chicago"),
            new("(UTC-07:00) Mountain Time", "America/Denver"),
            new("(UTC-07:00) Arizona", "America/Phoenix"),
            new("(UTC-08:00) Pacific Time", "America/Los_Angeles"),
            new("(UTC-09:00) Alaska", "America/Anchorage"),
            new("(UTC-10:00) Hawaii", "Pacific/Honolulu"),
            new("(UTC-03:00) São Paulo", "America/Sao_Paulo"),
            new("(UTC-06:00) Mexico City", "America/Mexico_City")
    ];

    protected override async Task OnInitializedAsync()
    {
        _selectTimeZone = _timeZoneOptions.FirstOrDefault(x => (string?)x.Value == _settings.TimeZoneId);
        _notifications = await _notificationService.GetAllAsync();
        _updateService.SubscribeToComponentUpdates(RefreshCallbackAsync);
        await base.OnInitializedAsync();
    }

    private async void RefreshCallbackAsync(object? sender, ICalendarUpdate? update)
    {
        _notifications = await _notificationService.GetAllAsync();
    }

    public void Dispose()
    {
        _updateService.UnsubscribeFromComponentUpdates(RefreshCallbackAsync);
    }

    private async Task OnClickDownloadBackup()
    {
        var backup = new BackupDto();
        backup.CalendarDays = _dtoService.FromDtoList(await _calService.GetAllAsync());
        backup.MedicineReports = _dtoService.FromDtoList(await _medReportService.GetAllAsync());
        backup.Medicines = _dtoService.FromDtoList(await _medService.GetAllAsync());
        backup.MedicineStateChanges = _dtoService.FromDtoList(await _medStateChangeService.GetAllAsync());
        backup.SymptomReports = _dtoService.FromDtoList(await _sympReportService.GetAllAsync());
        backup.Symptoms = _dtoService.FromDtoList(await _sympService.GetAllAsync());
        backup.SymptomStateChanges = _dtoService.FromDtoList(await _sympStateChangeService.GetAllAsync());

        var json = JsonSerializer.Serialize(backup);

        try
        {
            FileDownloadService.SaveToDownloads(json, "backup.json");
            _notifier.ShowNotification("Backup Downloaded", "Backup successfully saved to downloads folder.");
        }
        catch (Exception ex)
        {
            _notifier.ShowNotification("Error Downloading Backup", ex.Message);
        }
    }

    private async Task OnClickDeleteDatabase()
    {
        var request = new ConfirmationRequest();
        request.Message = "Are you sure you want to delete the database file? This will delete all of the history in the application. There is no automatic backup.";
        request.TrueOption = new(true, "Yes");
        request.FalseOption = new(false, "No");
        var result = await _confirmService.ShowAsync(request);
        if (!result.Result) return;

        string dbPath = Path.Combine(FileSystem.AppDataDirectory, "ibdiary_db.db");
        if (File.Exists(dbPath))
        {
            try
            {
                File.Delete(dbPath);
                _notifier.ShowNotification("Database Deleted", $"Database successfully file deleted from {dbPath}");
            }
            catch (Exception ex)
            {
                _notifier.ShowNotification("Error Deleting Database", ex.Message);
            }
        }
        else _notifier.ShowNotification("Error Deleting Database", "Could not find database file to delete.");
    }

    private void OnSettingsChanged()
    {
        _settings.Save();
    }

    private void OnNotificationClicked(ScheduledNotificationDto notification)
    {
        _currentNotification = notification;
        _notificationViewerVisible = true;
    }

    private void OnClickNewNotification()
    {
        _currentNotification = new();
        _notificationViewerVisible = true;
    }

    private void OnTimeZoneChanged()
    {
        if (_selectTimeZone?.Value is not string timeZoneId) return;

        _settings.TimeZoneId = timeZoneId;
        _settings.Save();
    }
}
