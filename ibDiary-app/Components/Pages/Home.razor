@implements IDisposable
@inject PendingMedicineReportService _pendingMedService
@inject MedicineClientService _medDbService
@inject SymptomClientService _symDbSevrice
@inject NavigationManager _navManager
@inject ComponentUpdateService _updateService
@page "/"

<article class="home-page">
    <header>
        <button @onclick="@OnClickAdd">
            <span class="material-symbols-outlined">add</span>
        </button>
    </header>

    @if (_pendingReports.Count > 0)
    {
        <div class="pending-reports">
            <header>
                <h2>Pending Reports</h2>
            </header>
            <div>
                <p>The following medicines are due reports.</p>
                <div>
                    @foreach (var report in _pendingReports)
                    {
                        <MedicineReportRow MedicineReport="report" />
                    }
                </div>
            </div>

        </div>
    }
    <div class="current-medicines" @onclick="@OnClickCurrentMedicines">
        <header>
            <h2>Active Medicines</h2>
            <button @onclick="@ShowMedicineHelpClicked" @onclick:stopPropagation="true">
                <span class="material-symbols-outlined">help</span>
            </button>
        </header>
        <div>
            @if (_currentMedicines.Count > 0)
            {
                @foreach (var active in _currentMedicines)
                {
                    <MedicineSmallCard Medicine="active" MedicineClicked="@OnMedicineRowClicked" />
                }
            }
            else
            {
                <p>You have no active medicines.</p>
            }
        </div>
    </div>
    <div class="current-symptoms" @onclick="@OnClickCurrentSymptoms">
        <header>
            <h2>Active Symptoms</h2>
            <button @onclick="@ShowSymtpomHelpClicked" @onclick:stopPropagation="true">
                <span class="material-symbols-outlined">help</span>
            </button>
        </header>
        <div>
            @if (_currentSymptoms.Count > 0)
            {
                @foreach (var active in _currentSymptoms)
                {
                    <SymptomSmallCard Symptom="active" SymptomClicked="@OnSymptomRowClicked" />
                }
            }
            else
            {
                <p>You have no active symptoms.</p>
            }
        </div>

    </div>
</article>

<MedicineViewer Medicine="@_currentMedicine" @bind-Visible="@_medicineViewerVisible"/>
<SymptomViewer Symptom="@_currentSymptom" @bind-Visible="@_symptomViewerVisible" />
<SymptomHelpPopup @bind-Visible="@_symptomHelpVisible"/>
<MedicineHelpPopup @bind-Visible="@_medicineHelpVisible"/>
<NewItemPopup @bind-Visible="@_newItemVisible" HasOwnControl="false" />

@code {
    private List<MedicineReport> _pendingReports = [];

    private List<Medicine> _currentMedicines = [];
    private Medicine _currentMedicine = new();
    private bool _medicineViewerVisible = false;

    private List<Symptom> _currentSymptoms = [];
    private Symptom _currentSymptom = new();
    private bool _symptomViewerVisible = false;

    private bool _symptomHelpVisible = false;
    private bool _medicineHelpVisible = false;

    private bool _newItemVisible = false;

    protected override async Task OnInitializedAsync()
    {
        await RefreshHomeAsync();
        _updateService.SubscribeToComponentUpdates(RefreshHomeCallbackAsync);
        await base.OnInitializedAsync();
    }

    private async void RefreshHomeCallbackAsync(object? sender, ICalendarUpdate update)
    {
        await RefreshHomeAsync();
        StateHasChanged();
    }

    public void Dispose()
    {
        _updateService.UnsubscribeFromComponentUpdates(RefreshHomeCallbackAsync);
    }

    private async Task RefreshHomeAsync()
    {
        _pendingReports = await _pendingMedService.GetPendingReportsAsync();
        var meds = await _medDbService.GetAllAsync();
        _currentMedicines = meds.Where(x => x.Active).ToList();
        var symps = await _symDbSevrice.GetAllAsync();
        _currentSymptoms = symps.Where(x => x.Active).ToList();
    }

    private async Task OnMedicineReportChanged(MedicineReport report)
    {
        _pendingReports = await _pendingMedService.GetPendingReportsAsync();
    }

    private void OnMedicineRowClicked(Medicine medicine)
    {
        _currentMedicine = medicine;
        _medicineViewerVisible = true;
    }

    private void OnSymptomRowClicked(Symptom symptom)
    {
        _currentSymptom = symptom;
        _symptomViewerVisible = true;
    }

    private void OnClickCurrentMedicines()
    {
        if (_currentMedicines.Count == 0) _navManager.NavigateTo("/medicines");
    }

    private void OnClickCurrentSymptoms()
    {
        if (_currentSymptoms.Count == 0) _navManager.NavigateTo("/symptoms");
    }

    private void ShowSymtpomHelpClicked()
    {
        _symptomHelpVisible = true;
    }

    private void ShowMedicineHelpClicked()
    {
        _medicineHelpVisible = true;
    }

    private void OnClickAdd()
    {
        _newItemVisible = true;
    }
}


